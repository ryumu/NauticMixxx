<Template>
  <WidgetGroup>
    <ObjectName>RX3Topbar</ObjectName><Connection><ConfigKey>[Tab],library</ConfigKey><BindProperty>visible</BindProperty><Transform><Not/></Transform></Connection>
    <Layout>horizontal</Layout>
    <Size>0me,34f</Size>
    <Children>
      <WidgetGroup><ObjectName>RX3TransportRail</ObjectName><Layout>horizontal</Layout><Size>560f,28f</Size><Children>
      <WidgetGroup>
        <ObjectName>RX3RemainBlock</ObjectName>
        <Layout>horizontal</Layout>
        <Size>150f,0me</Size>
        <Children>
          <Label><ObjectName>RX3ClockIcon</ObjectName><Text>&#9716;</Text></Label>
          <Label><ObjectName>RX3RemainLabel</ObjectName><Text>REMAIN</Text></Label>
          <NumberPos>
            <ObjectName>RX3MasterTime</ObjectName><Rx3Format>transport</Rx3Format>
            <Channel>1</Channel>
            <NumberOfDigits>6</NumberOfDigits>
            <Connection><ConfigKey>[Channel1],playposition</ConfigKey></Connection>
          </NumberPos>
        </Children>
        <Connection><ConfigKey>[Tab],library</ConfigKey><BindProperty>visible</BindProperty><Transform><Not/></Transform></Connection>
      </WidgetGroup>

      <!-- Keep the narrow transport rail alongside the separate BROWSE action. -->
      <WidgetGroup>
        <ObjectName>RX3ProgressTrack</ObjectName>
        <Layout>horizontal</Layout>
        <Size>0me,4f</Size>
        <Children>
          <VuMeter>
            <ObjectName>RX3ProgressMeter</ObjectName>
            <PathVu>skin:/images/progress_fill.svg</PathVu>
            <PathBack>skin:/images/progress_back.svg</PathBack>
            <Horizontal>true</Horizontal>
            <PeakHoldSize>0</PeakHoldSize>
            <PeakHoldTime>0</PeakHoldTime>
            <PeakFallTime>0</PeakFallTime>
            <PeakFallStep>1</PeakFallStep>
            <Connection><ConfigKey>[Channel1],playposition</ConfigKey></Connection>
          </VuMeter>
        </Children>
      </WidgetGroup>

      </Children></WidgetGroup>
      <WidgetGroup>
        <ObjectName>RX3BrowseRemainBlock</ObjectName>
        <Layout>horizontal</Layout>
        <Size>112f,0me</Size>
        <Children>
          <Label><ObjectName>RX3BrowseClockIcon</ObjectName><Text>&#9716;</Text></Label>
          <NumberPos>
            <ObjectName>RX3BrowseMasterTime</ObjectName><Rx3Format>transport</Rx3Format>
            <Channel>1</Channel>
            <NumberOfDigits>6</NumberOfDigits>
            <Connection><ConfigKey>[Channel1],playposition</ConfigKey></Connection>
          </NumberPos>
        </Children>
        <Connection><ConfigKey>[Tab],library</ConfigKey><BindProperty>visible</BindProperty></Connection>
      </WidgetGroup>

      <WidgetGroup>
        <ObjectName>RX3TopbarGap</ObjectName><Layout>horizontal</Layout><Size>0me,34f</Size>
        <Children>
          <WidgetGroup><Size>0me,0me</Size></WidgetGroup>
          <WidgetGroup>
            <ObjectName>RX3SmartFxBadge</ObjectName><Layout>horizontal</Layout><Size>294f,28f</Size>
            <Children>
              <PushButton>
                <ObjectName>RX3SmartFxStatus</ObjectName><Size>136f,28f</Size><NumberStates>2</NumberStates>
                <LeftClickIsPushButton>true</LeftClickIsPushButton>
                <Tooltip>Smart CFX status. Click to select a preset or turn Smart CFX on/off.</Tooltip>
                <State><Number>0</Number><Text>SMART CFX  OFF</Text></State>
                <State><Number>1</Number><Text>SMART CFX  ON</Text></State>
                <Connection><ConfigKey>[RX3SmartFx],enabled</ConfigKey><ConnectValueFromWidget>false</ConnectValueFromWidget></Connection>
                <Connection><ConfigKey>[RX3SmartFx],preset_open</ConfigKey><ConnectValueToWidget>false</ConnectValueToWidget><EmitOnPressAndRelease>true</EmitOnPressAndRelease></Connection>
              </PushButton>
              <PushButton>
                <ObjectName>RX3SmartFxPreset</ObjectName><Size>158f,28f</Size><NumberStates>3</NumberStates>
                <LeftClickIsPushButton>true</LeftClickIsPushButton>
                <Tooltip>Select Smart CFX preset</Tooltip>
                <State><Number>0</Number><Text>ECHO + FILTER &#9662;</Text></State>
                <State><Number>1</Number><Text>REVERB + FILTER &#9662;</Text></State>
                <State><Number>2</Number><Text>FILTER &#9662;</Text></State>
                <Connection><ConfigKey>[RX3SmartFx],preset</ConfigKey><ConnectValueFromWidget>false</ConnectValueFromWidget></Connection>
                <Connection><ConfigKey>[RX3SmartFx],preset_open</ConfigKey><ConnectValueToWidget>false</ConnectValueToWidget><EmitOnPressAndRelease>true</EmitOnPressAndRelease></Connection>
              </PushButton>
            </Children>
          </WidgetGroup>
          <WidgetGroup><Size>0me,0me</Size></WidgetGroup>
        </Children>
      </WidgetGroup>
      <PushButton>
        <ObjectName>RX3AppMenu</ObjectName><Size>88f,34f</Size><NumberStates>1</NumberStates>
        <LeftClickIsPushButton>true</LeftClickIsPushButton>
        <Tooltip>Show the application menu bar</Tooltip>
        <State><Number>0</Number><Text>APP MENU</Text></State>
        <Connection><ConfigKey>[Master],show_menubar</ConfigKey><ConnectValueToWidget>false</ConnectValueToWidget><EmitOnPressAndRelease>true</EmitOnPressAndRelease></Connection>
      </PushButton>
      <PushButton>
        <ObjectName>RX3OpenBrowser</ObjectName><Size>104f,34f</Size><NumberStates>1</NumberStates>
        <Tooltip>Browse tracks</Tooltip>
        <State><Number>0</Number><Text>BROWSE</Text></State>
        <Connection><ConfigKey>[RX3Browser],open</ConfigKey><ConnectValueToWidget>false</ConnectValueToWidget></Connection>
      </PushButton>
      <WidgetGroup>
        <ObjectName>RX3TopbarStatus</ObjectName>
        <Layout>horizontal</Layout>
        <Size>194f,0me</Size>
        <Children>
          <Label><ObjectName>RX3RecordDot</ObjectName><Text>&#9679;</Text></Label>
          <Time><ObjectName>RX3Clock</ObjectName><TooltipId>time</TooltipId><Align>center</Align></Time>
          <Label><ObjectName>RX3InfoLabel</ObjectName><Text>◀ INFO</Text></Label>
        </Children>
      </WidgetGroup>
    </Children>
  </WidgetGroup>
</Template>
