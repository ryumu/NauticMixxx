+TEST(RekordboxUsbSessionTest, DeferredAnalysisPreservesOwnershipAndFingerprintGuards) {
+    QTemporaryDir volume;
+    ASSERT_TRUE(write(pdb(volume), database(rows())));
+    const auto path = volume.filePath("PIONEER/USBANLZ/test.DAT");
+    auto analysis = syntheticCueAnlz("/Contents/test.mp3");
+    QByteArray waveform(20, '\0');
+    waveform.replace(0, 4, "PWAV");
+    putAnlz32(&waveform, 4, 20); putAnlz32(&waveform, 8, 24); putAnlz32(&waveform, 12, 4);
+    const QByteArray payload("\x11\x22\x33\x44", 4);
+    waveform += payload; analysis += waveform; putAnlz32(&analysis, 8, analysis.size());
+    ASSERT_TRUE(write(path, analysis));
+    RekordboxUsbSession session(volume.path()); ASSERT_TRUE(session.load());
+    PerformanceEdit premature; premature.trackId = 1;
+    premature.binding = mixxx::SourceBinding::rekordboxUsb(1, session.sessionState());
+    EXPECT_FALSE(session.writePerformance(premature).isEmpty());
+    EXPECT_FALSE(QFile::exists(path + ".nauticmixxx-performance-backup"));
+    const auto inspected = session.loadTrackAnalysis(1);
+    ASSERT_TRUE(inspected); ASSERT_EQ(1, inspected->waveforms.size());
+    const auto descriptor = inspected->waveforms.first();
+    const auto loaded = session.loadWaveformPayload(descriptor);
+    ASSERT_TRUE(loaded); EXPECT_EQ(payload, *loaded);
+    const auto modified = QFileInfo(path).lastModified();
+    auto changed = analysis; changed[changed.size() - 1] = char(0x55);
+    ASSERT_TRUE(write(path, changed));
+    QFile timestamps(path); ASSERT_TRUE(timestamps.open(QIODevice::ReadWrite));
+    ASSERT_TRUE(timestamps.setFileTime(modified, QFileDevice::FileModificationTime)); timestamps.close();
+    EXPECT_FALSE(session.loadWaveformPayload(descriptor));
+
+    // An analysis file belonging to another audio path cannot supply cues.
+    ASSERT_TRUE(write(path, syntheticCueAnlz("/Contents/different.mp3")));
+    RekordboxUsbSession wrongOwner(volume.path()); ASSERT_TRUE(wrongOwner.load());
+    const auto rejected = wrongOwner.loadTrackAnalysis(1); ASSERT_TRUE(rejected);
+    EXPECT_EQ(RuntimeAnalysisState::Missing, rejected->analysisState);
+    EXPECT_TRUE(rejected->cues.isEmpty()); EXPECT_TRUE(rejected->waveforms.isEmpty());
+
+    // Replacing the PDB before the first deferred read revokes the session.
+    RekordboxUsbSession replaced(volume.path()); ASSERT_TRUE(replaced.load());
+    ASSERT_TRUE(write(pdb(volume), database({{0, track(2)}})));
+    EXPECT_FALSE(replaced.loadTrackAnalysis(1));
+    EXPECT_EQ(UsbSessionState::Invalidated, replaced.state());
+}
