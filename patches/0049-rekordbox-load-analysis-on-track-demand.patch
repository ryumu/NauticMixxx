+TEST(RekordboxUsbSessionTest, ConcurrentDeferredInspectionIsCoherentAndInvalidationIsTerminal) {
+    QTemporaryDir volume;
+    ASSERT_TRUE(write(pdb(volume), database(rows())));
+    ASSERT_TRUE(write(volume.filePath("PIONEER/USBANLZ/test.DAT"), syntheticCueAnlz("/Contents/test.mp3")));
+    RekordboxUsbSession session(volume.path());
+    ASSERT_TRUE(session.load());
+    std::optional<RuntimeTrack> first, second;
+    std::atomic<bool> start{false};
+    std::thread worker1([&] { while (!start.load()) std::this_thread::yield(); first = session.loadTrackAnalysis(1); });
+    std::thread worker2([&] { while (!start.load()) std::this_thread::yield(); second = session.loadTrackAnalysis(1); });
+    start.store(true);
+    worker1.join(); worker2.join();
+    ASSERT_TRUE(first); ASSERT_TRUE(second);
+    EXPECT_EQ(4, first->cues.size()); EXPECT_EQ(4, second->cues.size());
+    EXPECT_EQ(first->analysisFingerprints, second->analysisFingerprints);
+    EXPECT_EQ(first->diagnostics, second->diagnostics);
+    const auto catalog = session.catalog();
+    session.invalidate();
+    EXPECT_FALSE(session.loadTrackAnalysis(1));
+    EXPECT_FALSE(session.createTemporaryTrack(1));
+    EXPECT_FALSE(catalog->valid()); EXPECT_TRUE(catalog->tracks().isEmpty());
+    EXPECT_EQ(UsbSessionState::Invalidated, session.state());
+}
