+std::optional<RuntimeTrack> RekordboxUsbSession::loadTrackAnalysis(
+        quint32 rekordboxId, QString* error) {
+    if (error) error->clear();
+    const auto fail = [error](const QString& message) -> std::optional<RuntimeTrack> {
+        if (error) *error = message;
+        return std::nullopt;
+    };
+    const std::lock_guard<std::mutex> analysisLock(m_analysisMutex);
+    if (!refresh()) return fail(QStringLiteral("Rekordbox USB source changed or disappeared"));
+    std::optional<RuntimeTrack> track;
+    std::shared_ptr<RuntimeCatalog> catalog;
+    QString root;
+    {
+        const std::lock_guard<std::mutex> lock(m_mutex);
+        if (m_state != UsbSessionState::Ready || !m_catalog || !m_sessionState->isActive())
+            return fail(QStringLiteral("Rekordbox USB session is not ready"));
+        catalog = m_catalog;
+        track = catalog->findTrack(rekordboxId);
+        root = m_root;
+    }
+    if (!track) return fail(QStringLiteral("Unknown Rekordbox track identifier"));
+    if (track->analysisState != RuntimeAnalysisState::Unknown) return track;
+
+    applyAnlz(root, m_sessionId, &*track);
+    if (!refresh()) return fail(QStringLiteral("USB source changed during analysis inspection"));
+    const std::lock_guard<std::mutex> lock(m_mutex);
+    if (m_state != UsbSessionState::Ready || m_catalog != catalog ||
+            !m_sessionState->isActive() || !catalog->publishAnalysis(*track))
+        return fail(QStringLiteral("USB session invalidated during analysis inspection"));
+    // Take fresh PDB metadata too: a rating write may have completed during I/O.
+    return catalog->findTrack(rekordboxId);
 }
 
