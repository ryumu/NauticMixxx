+QString RekordboxFeature::rootForBinding(const mixxx::SourceBinding& binding) const {
+    if (binding.sourceType() != mixxx::SourceType::RekordboxUsb || !binding.isSessionLive()) return {};
+    for (auto it = m_sessions.cbegin(); it != m_sessions.cend(); ++it) {
+        const auto state = it.value()->sessionState();
+        if (!state || !(state->identifier() == binding.sessionIdentifier())) continue;
+        const auto catalog = it.value()->catalog();
+        if (catalog && catalog->findTrack(binding.rekordboxId())) return it.key();
     }
     return {};
 }
