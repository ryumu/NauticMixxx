+// Consume BrowserPlaybackState's append-only list once. Idle history ticks
+// inspect only active sessions, never previous tracks or the USB catalog.
+class UsbHistoryLedger {
+  public:
+    struct Entry {
+        QString root;
+        QList<quint32> ids;
+        QSet<quint32> seen;
+    };
+    template<typename RootResolver>
+    void collect(const QList<TrackPointer>& played, RootResolver resolveRoot) {
+        while (m_processed < played.size()) {
+            const auto& track = played[m_processed++];
+            if (!track) continue;
+            const auto& binding = track->getSourceBinding();
+            if (binding.sourceType() != mixxx::SourceType::RekordboxUsb || !track->isSourceAvailableForPlayback()) continue;
+            const auto identity = binding.sessionIdentifier().uuid().toString();
+            const auto previous = m_entries.constFind(identity);
+            if (previous != m_entries.cend() && previous->seen.contains(binding.rekordboxId())) continue;
+            const auto root = resolveRoot(binding);
+            if (root.isEmpty()) continue;
+            auto& entry = m_entries[identity];
+            entry.root = root;
+            entry.ids.append(binding.rekordboxId());
+            entry.seen.insert(binding.rekordboxId());
+        }
+    }
+    const QHash<QString, Entry>& entries() const { return m_entries; }
+    void forget(const QString& identity) { m_entries.remove(identity); }
+  private:
+    qsizetype m_processed = 0;
+    QHash<QString, Entry> m_entries;
+};
