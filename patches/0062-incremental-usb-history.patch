+class Rx3UsbHistoryTest : public MixxxTest {};
+TEST_F(Rx3UsbHistoryTest, IdleTicksResolveOnlyNewUsbTracksAndPreserveOrder) {
+    auto session = std::make_shared<mixxx::rekordbox::SessionState>();
+    auto make = [&](quint32 id) {
+        return Track::newTemporary(mixxx::FileAccess(mixxx::FileInfo(QString("/tmp/history-%1.wav").arg(id))),
+                mixxx::TrackUsePolicy::rekordboxUsbPolicy(), mixxx::SourceBinding::rekordboxUsb(id, session));
+    };
+    const auto first = make(1), second = make(2), third = make(3);
+    const auto local = Track::newTemporary(mixxx::FileAccess(mixxx::FileInfo("/tmp/local.wav")));
+    QList<TrackPointer> played{first, local, second};
+    int lookups = 0;
+    auto root = [&](const mixxx::SourceBinding&) { ++lookups; return QString("/usb"); };
+    rx3::UsbHistoryLedger history;
+    history.collect(played, root);
+    ASSERT_EQ(2, lookups);
+    for (int tick = 0; tick < 1000; ++tick) history.collect(played, root);
+    EXPECT_EQ(2, lookups);
+    played.append(first); // Defensive deduplication even if the source list repeats an ID.
+    played.append(third);
+    history.collect(played, root);
+    EXPECT_EQ(3, lookups);
+    const auto identity = session->identifier().uuid().toString();
+    ASSERT_EQ(1, history.entries().size());
+    EXPECT_EQ(QString("/usb"), history.entries().value(identity).root);
+    EXPECT_EQ((QList<quint32>{1, 2, 3}), history.entries().value(identity).ids);
+}
+
+TEST_F(Rx3UsbHistoryTest, ReplacementAtSameRootDoesNotMergeOrResurrectDisconnectedHistory) {
+    auto oldSession = std::make_shared<mixxx::rekordbox::SessionState>();
+    auto newSession = std::make_shared<mixxx::rekordbox::SessionState>();
+    auto make = [](quint32 id, const std::shared_ptr<mixxx::rekordbox::SessionState>& session) {
+        return Track::newTemporary(mixxx::FileAccess(mixxx::FileInfo("/tmp/history.wav")),
+                mixxx::TrackUsePolicy::rekordboxUsbPolicy(), mixxx::SourceBinding::rekordboxUsb(id, session));
+    };
+    QList<TrackPointer> played{make(1, oldSession), make(1, newSession)};
+    int lookups = 0;
+    auto root = [&](const mixxx::SourceBinding&) { ++lookups; return QString("/same-mount"); };
+    rx3::UsbHistoryLedger history;
+    history.collect(played, root);
+    ASSERT_EQ(2, history.entries().size());
+    const auto oldIdentity = oldSession->identifier().uuid().toString();
+    const auto newIdentity = newSession->identifier().uuid().toString();
+    oldSession->invalidate();
+    history.forget(oldIdentity);
+    played.append(make(2, oldSession));
+    history.collect(played, root);
+    EXPECT_EQ(2, lookups);
+    EXPECT_FALSE(history.entries().contains(oldIdentity));
+    ASSERT_EQ(1, history.entries().size());
+    EXPECT_EQ((QList<quint32>{1}), history.entries().value(newIdentity).ids);
+}
