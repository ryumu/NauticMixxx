diff --git a/src/test/rx3beatfx_test.cpp b/src/test/rx3beatfx_test.cpp
--- a/src/test/rx3beatfx_test.cpp
+++ b/src/test/rx3beatfx_test.cpp
@@ -1105,3 +1105,48 @@
