+
+// Compare lazy history invalidation with a physically zeroed reference over
+// delay changes, feedback, full-ring reads, repeated resets and ring wraps.
+TEST(Rx3EchoAudioTest, ResetNeverReplaysOldHistoryAcrossDelayChangesAndWraps) {
+    constexpr int frames = 37;
+    const mixxx::EngineParameters engineParameters(mixxx::audio::SampleRate(8000), frames);
+    const auto manifest = EchoEffect::getManifest();
+    QMap<QString, EngineEffectParameterPointer> parameters;
+    for (const auto& parameter : manifest->parameters()) {
+        parameters.insert(parameter->id(), EngineEffectParameterPointer(new EngineEffectParameter(parameter)));
+    }
+    parameters["rx3_exact_time"]->setValue(1);
+    parameters["quantize"]->setValue(0);
+    parameters["send_amount"]->setValue(.7);
+    parameters["feedback_amount"]->setValue(.8);
+    parameters["pingpong_amount"]->setValue(.4);
+    EchoEffect echo;
+    echo.loadEngineEffectParameters(parameters);
+    EchoGroupState state(engineParameters), reference(engineParameters);
+    std::fill(state.delay_buf.data(), state.delay_buf.data() + state.delay_buf.size(), .875f);
+    reference.delay_buf.clear();
+    reference.valid_samples = reference.delay_buf.size();
+    mixxx::SampleBuffer input(frames * 2), output(frames * 2), expected(frames * 2);
+    GroupFeatureState features;
+    features.beat_length = GroupFeatureBeatLength{1.5, 1};
+    for (int block = 0; block < 4000; ++block) {
+        const double periods[] = {4, .0625, .5, 2};
+        parameters["delay_time"]->setValue(periods[(block / 127) % 4]);
+        for (int sample = 0; sample < frames * 2; ++sample) {
+            input[sample] = block < 1800 ? CSAMPLE(.2 * std::sin((block * frames * 2 + sample) * .17)) : 0;
+        }
+        const bool disabling = block == 5 || block == 43 || block == 1700 || block == 1701 || block == 1900;
+        const auto enabled = disabling ? EffectEnableState::Disabling : EffectEnableState::Enabled;
+        echo.processChannel(&state, input.data(), output.data(), engineParameters, enabled, features);
+        echo.processChannel(&reference, input.data(), expected.data(), engineParameters, enabled, features);
+        if (disabling) {
+            reference.delay_buf.clear();
+            reference.valid_samples = reference.delay_buf.size();
+        }
+        for (int sample = 0; sample < frames * 2; ++sample) {
+            ASSERT_FLOAT_EQ(expected[sample], output[sample]) << "block " << block << " sample " << sample;
+        }
+        if (block == 5) EXPECT_FLOAT_EQ(.875f, state.delay_buf[state.delay_buf.size() - 1]);
+    }
+}
