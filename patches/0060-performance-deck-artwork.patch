+class RekordboxArtworkTest : public LibraryTest {};
+
+TEST_F(RekordboxArtworkTest, ExportedArtworkRendersAndClearsWhenTrackChanges) {
+    QTemporaryDir volume;
+    auto song = track();
+    put32(&song, 28, 7);
+    QByteArray artworkRow(4, '\0');
+    put32(&artworkRow, 0, 7);
+    ASSERT_TRUE(write(pdb(volume), database({{0, song},
+            {13, artworkRow + text("/PIONEER/art.png")}})));
+    ASSERT_TRUE(write(volume.filePath("Contents/test.mp3"), "audio fixture"));
+    QImage artwork(800, 400, QImage::Format_RGB32);
+    artwork.fill(Qt::red);
+    ASSERT_TRUE(artwork.save(volume.filePath("PIONEER/art.png")));
+    RekordboxUsbSession session(volume.path());
+    ASSERT_TRUE(session.load());
+    auto projected = session.createTemporaryTrack(1);
+    ASSERT_TRUE(projected);
+    const auto snapshot = projected->property("rekordboxArtwork").value<QImage>();
+    ASSERT_EQ(QSize(512, 256), snapshot.size());
+    EXPECT_FALSE(projected->getCoverInfo().hasImage()); // no deferred USB path
+    EXPECT_FALSE(projected->getId().isValid());
+
+    WCoverArt cover(nullptr, config(), "[Channel1]", nullptr);
+    QDomDocument xml;
+    ASSERT_TRUE(xml.setContent(QStringLiteral("<CoverArt><BgColor>#202020</BgColor></CoverArt>")));
+    SkinContext context(config(), QString());
+    cover.resize(48, 48);
+    cover.setup(xml.documentElement(), context);
+    cover.show();
+    cover.slotLoadTrack(projected);
+    QCoreApplication::processEvents();
+    const auto centerColor = [&cover] {
+        const auto image = cover.grab().toImage();
+        return image.pixelColor(image.width() / 2, image.height() / 2);
+    };
+    EXPECT_EQ(QColor(Qt::red), centerColor());
+    EXPECT_EQ(QColor("#202020"), cover.grab().toImage().pixelColor(24, 2));
+
+    // Rendering and resizing use the snapshot even after removal.
+    ASSERT_TRUE(QFile::remove(volume.filePath("PIONEER/art.png")));
+    session.invalidate();
+    cover.resize(72, 72);
+    EXPECT_EQ(QColor(Qt::red), centerColor());
+    cover.slotLoadingTrack({}, projected);
+    EXPECT_NE(QColor(Qt::red), centerColor());
+    cover.slotLoadTrack(Track::newTemporary());
+    EXPECT_NE(QColor(Qt::red), centerColor());
+}
+
+TEST_F(RekordboxArtworkTest, MissingCorruptOversizedAndEscapingArtworkDoNotBlockLoading) {
+    for (const QString& kind : {QStringLiteral("missing"), QStringLiteral("corrupt"),
+                 QStringLiteral("oversized"), QStringLiteral("escape")}) {
+        SCOPED_TRACE(kind.toStdString());
+        QTemporaryDir volume;
+        auto song = track();
+        put32(&song, 28, 7);
+        QByteArray artworkRow(4, '\0');
+        put32(&artworkRow, 0, 7);
+        const auto path = kind == "escape" ? "/../outside.png" : "/PIONEER/art.png";
+        ASSERT_TRUE(write(pdb(volume), database({{0, song}, {13, artworkRow + text(path)}})));
+        ASSERT_TRUE(write(volume.filePath("Contents/test.mp3"), "audio fixture"));
+        if (kind == "corrupt") ASSERT_TRUE(write(volume.filePath("PIONEER/art.png"), "not an image"));
+        if (kind == "oversized") ASSERT_TRUE(write(volume.filePath("PIONEER/art.png"), QByteArray(8 * 1024 * 1024 + 1, 'x')));
+        RekordboxUsbSession session(volume.path());
+        ASSERT_TRUE(session.load());
+        const auto projected = session.createTemporaryTrack(1);
+        ASSERT_TRUE(projected);
+        EXPECT_TRUE(projected->property("rekordboxArtwork").value<QImage>().isNull());
+    }
 }

