+TEST(RekordboxUsbSessionTest, StateReadersAndRefreshRemainCoherentDuringConcurrentSaves) {
+    QTemporaryDir volume;
+    auto data = rows();
+    for (quint32 id = 2; id <= 1000; ++id)
+        data.append({0, track(id, QString("/Contents/%1.mp3").arg(id).toUtf8())});
+    ASSERT_TRUE(write(pdb(volume), database(data)));
+    RekordboxUsbSession session(volume.path());
+    ASSERT_TRUE(session.load());
+    std::atomic<bool> finished{false};
+    std::atomic<int> refreshErrors{0};
+    QString writeError;
+    QSemaphore start;
+    std::thread writer([&] {
+        start.release();
+        for (int rating = 0; rating < 10; ++rating) {
+            writeError = session.writeRating(1, rating % 6);
+            if (!writeError.isEmpty()) break;
+        }
+        if (writeError.isEmpty()) writeError = session.writeList("Concurrent history", {1}, true);
+        finished.store(true);
+    });
+    start.acquire();
+    std::thread refresher([&] {
+        for (int i = 0; i < 20; ++i) if (!session.refresh()) ++refreshErrors;
+    });
+    int reads = 0;
+    qint64 maximumReadNs = 0;
+    while (!finished.load()) {
+        QElapsedTimer elapsed; elapsed.start();
+        EXPECT_EQ(UsbSessionState::Ready, session.state());
+        EXPECT_TRUE(session.catalog());
+        EXPECT_TRUE(session.sessionState());
+        maximumReadNs = std::max(maximumReadNs, elapsed.nsecsElapsed());
+        ++reads;
+        std::this_thread::yield();
+    }
+    writer.join();
+    refresher.join();
+    EXPECT_TRUE(writeError.isEmpty()) << writeError.toStdString();
+    EXPECT_EQ(0, refreshErrors.load());
+    EXPECT_TRUE(session.refresh());
+    EXPECT_EQ(3u, session.catalog()->findTrack(1)->rating);
+    EXPECT_EQ(1, session.catalog()->histories().size());
+    RecordProperty("state_reads_during_saves", reads);
+    RecordProperty("maximum_state_read_us", std::to_string(maximumReadNs / 1000.0));
+}
+
+TEST(RekordboxUsbSessionTest, RevokedWriteSnapshotsCannotCommitOrRepublishCatalog) {
+    QTemporaryDir volume;
+    const auto original = database(rows());
+    ASSERT_TRUE(write(pdb(volume), original));
+    RekordboxUsbSession session(volume.path());
+    ASSERT_TRUE(session.load());
+    auto snapshot = session.deviceSnapshot();
+    const auto token = session.sessionState();
+    const auto catalog = session.catalog();
+    session.invalidate();
+    QByteArray fingerprint;
+    quint32 id = 0;
+    EXPECT_FALSE(writeUsbRating(snapshot, 1, "/Contents/test.mp3", 5, &fingerprint, token).isEmpty());
+    EXPECT_FALSE(writeUsbList(&snapshot, "Stale", {1}, false, &id, token).isEmpty());
+    EXPECT_FALSE(session.writeRating(1, 5).isEmpty());
+    EXPECT_FALSE(session.writeList("Stale", {1}, false).isEmpty());
+    EXPECT_FALSE(catalog->valid());
+    EXPECT_FALSE(session.catalog());
+    QFile unchanged(pdb(volume)); ASSERT_TRUE(unchanged.open(QIODevice::ReadOnly));
+    EXPECT_EQ(original, unchanged.readAll());
+    EXPECT_FALSE(QFileInfo::exists(pdb(volume) + ".nauticmixxx-rating-backup"));
+    EXPECT_FALSE(QFileInfo::exists(pdb(volume) + ".nauticmixxx-playlist-backup"));
+}
