+TEST_F(Rx3BeatFxTest, ControllerStepsUseDisplayedEffectAndLeaveAudioOff) {
+    QWidget parent;
+    WRx3BeatFx panel(config(), effects.get(), &parent);
+    const auto list = rx3BeatFxManifests(effects->getBackendManager());
+    ASSERT_GT(list.size(), 1);
+    EXPECT_DOUBLE_EQ(1, ControlObject::get(ConfigKey("[RX3BeatFx]", "controller_api")));
+    const auto pulse = [](const QString& key, double value) {
+        ControlObject::set(ConfigKey("[RX3BeatFx]", key), value);
+        ControlObject::set(ConfigKey("[RX3BeatFx]", key), 0);
+    };
+    pulse("effect_step", 1);
+    ASSERT_TRUE(slot->isLoaded());
+    EXPECT_EQ(list.first()->uniqueId(), slot->getManifest()->uniqueId());
+    EXPECT_DOUBLE_EQ(0, enabled());
+    pulse("effect_step", -1);
+    EXPECT_EQ(list.last()->uniqueId(), slot->getManifest()->uniqueId());
+    pulse("effect_step", 1);
+    EXPECT_EQ(list.first()->uniqueId(), slot->getManifest()->uniqueId());
+    pulse("effect_step", 1);
+    EXPECT_EQ(list[1]->uniqueId(), slot->getManifest()->uniqueId());
+    EXPECT_DOUBLE_EQ(0, enabled());
+
+    panel.selectEffect(effects->getBackendManager()->getManifestFromUniqueId(
+            "org.mixxx.effects.echo"), false);
+    pulse("beat_step", 1);
+    ASSERT_TRUE(rx3FxParameter(slot, "delay_time"));
+    const double first = rx3FxParameter(slot, "delay_time")->getValue();
+    pulse("beat_step", 1);
+    EXPECT_GT(rx3FxParameter(slot, "delay_time")->getValue(), first);
+    EXPECT_DOUBLE_EQ(0, enabled());
+    EXPECT_DOUBLE_EQ(0, ControlObject::get(ConfigKey(slot->getGroup(), "enabled")));
+    ControlObject::set(ConfigKey("[RX3BeatFx]", "xpad_hold"), 1);
+    EXPECT_DOUBLE_EQ(1, enabled());
+    pulse("effect_step", 1);
+    EXPECT_DOUBLE_EQ(0, enabled());
+    EXPECT_DOUBLE_EQ(0, ControlObject::get(ConfigKey("[RX3BeatFx]", "xpad_hold")));
+}
