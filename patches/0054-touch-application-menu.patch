diff --git a/src/test/rx3touchmenu_test.cpp b/src/test/rx3touchmenu_test.cpp
new file mode 100644
--- /dev/null
+++ b/src/test/rx3touchmenu_test.cpp
@@ -0,0 +1,72 @@
+#include <QtTest>
+#include <QDomDocument>
+#include <QVBoxLayout>
+
+#include "controllers/controllermanager.h"
+#include "controllers/keyboard/keyboardeventfilter.h"
+#include "skin/legacy/legacyskinparser.h"
+#include "test/mixxxtest.h"
+#include "widget/wmainmenubar.h"
+#include "widget/wpushbutton.h"
+
+class Rx3TouchMenuTest : public MixxxTest {};
+
+TEST_F(Rx3TouchMenuTest, PerformanceButtonRecoversHiddenMenuRepeatedlyWithoutChangingAutoHide) {
+#ifdef __APPLE__
+    GTEST_SKIP() << "macOS manages the native menu bar";
+#else
+    const QString skinDir = qEnvironmentVariable("NAUTIC_SKIN_DIR");
+    if (skinDir.isEmpty()) GTEST_SKIP() << "Set NAUTIC_SKIN_DIR for actual skin bindings";
+    QFile source(QDir(skinDir).filePath("topbar.xml"));
+    ASSERT_TRUE(source.open(QIODevice::ReadOnly));
+    QDomDocument topbar;
+    ASSERT_TRUE(topbar.setContent(source.readAll()));
+    QDomElement button;
+    const auto buttons = topbar.elementsByTagName("PushButton");
+    for (int i = 0; i < buttons.size(); ++i) {
+        const auto candidate = buttons.at(i).toElement();
+        if (candidate.firstChildElement("ObjectName").text() == "RX3AppMenu") button = candidate;
+    }
+    ASSERT_FALSE(button.isNull());
+    QTemporaryDir directory;
+    QDomDocument skin;
+    auto root = skin.createElement("skin"); skin.appendChild(root);
+    auto skinLayout = skin.createElement("Layout");
+    skinLayout.appendChild(skin.createTextNode("horizontal")); root.appendChild(skinLayout);
+    auto children = skin.createElement("Children"); root.appendChild(children);
+    children.appendChild(skin.importNode(button, true));
+    QFile definition(directory.filePath("skin.xml"));
+    ASSERT_TRUE(definition.open(QIODevice::WriteOnly));
+    definition.write(skin.toByteArray()); definition.close();
+    ConfigObject<ConfigValueKbd> keyboardConfig(directory.filePath("keyboard.cfg"));
+    QWidget window;
+    auto* layout = new QVBoxLayout(&window);
+    WMainMenuBar menu(&window, config(), &keyboardConfig);
+    layout->addWidget(&menu);
+    QSet<ControlObject*> skinControls;
+    KeyboardEventFilter keyboard(&keyboardConfig);
+    ControllerManager controllers(config());
+    LegacySkinParser parser(config(), &skinControls, &keyboard, nullptr, &controllers,
+            nullptr, nullptr, nullptr, nullptr);
+    auto* canvas = parser.parseSkin(directory.path(), &window);
+    ASSERT_TRUE(canvas);
+    layout->addWidget(canvas);
+    auto* appMenu = canvas->findChild<WPushButton*>("RX3AppMenu");
+    ASSERT_TRUE(appMenu);
+    config()->setValue(ConfigKey("[Config]", "hide_menubar"), 1);
+    window.show();
+    for (int i = 0; i < 3; ++i) {
+        menu.hideMenuBar();
+        QCoreApplication::processEvents();
+        ASSERT_EQ(0, menu.height());
+        QTest::mouseClick(appMenu, Qt::LeftButton);
+        QCoreApplication::processEvents();
+        EXPECT_GT(menu.height(), 0);
+        EXPECT_EQ(0, ControlObject::get(ConfigKey("[Master]", "show_menubar")));
+        EXPECT_TRUE(config()->getValue<bool>(ConfigKey("[Config]", "hide_menubar"), false));
+    }
+    window.hide();
+    delete canvas;
+    qDeleteAll(skinControls);
+#endif
+}
