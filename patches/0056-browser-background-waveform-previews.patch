+template<typename Predicate>
+bool waitForBrowserPreview(Predicate ready) {
+    QElapsedTimer timer;
+    timer.start();
+    while (!ready() && timer.elapsed() < 5000) {
+        QCoreApplication::processEvents();
+        QThread::msleep(1);
+    }
+    return ready();
+}
+
+// Hold QtConcurrent work until a model reset/invalidation is in place, so the
+// stale-completion tests do not depend on disk speed or thread scheduling.
+class PausedBrowserPreviewReads {
+  public:
+    PausedBrowserPreviewReads()
+            : m_pool(QThreadPool::globalInstance()), m_maxThreads(m_pool->maxThreadCount()) {
+        m_pool->waitForDone();
+        m_pool->setMaxThreadCount(1);
+        m_blocker = QtConcurrent::run([this] { m_gate.acquire(); });
+    }
+    ~PausedBrowserPreviewReads() {
+        resume();
+        m_pool->waitForDone();
+    }
+    void resume() {
+        if (!m_paused) return;
+        m_paused = false;
+        m_gate.release();
+        m_blocker.waitForFinished();
+        m_pool->setMaxThreadCount(m_maxThreads);
+    }
+  private:
+    QThreadPool* m_pool;
+    int m_maxThreads;
+    QSemaphore m_gate;
+    QFuture<void> m_blocker;
+    bool m_paused{true};
+};
+
+QByteArray syntheticBrowserPreview(const QString& owner) {
+    auto analysis = syntheticCueAnlz(owner);
+    for (const auto& tag : {QByteArray("PWV4"), QByteArray("PWV6")}) {
+        const int header = tag == "PWV4" ? 24 : 20;
+        const int stride = tag == "PWV4" ? 6 : 3;
+        QByteArray section(header, '\0');
+        section.replace(0, 4, tag);
+        putAnlz32(&section, 4, header);
+        putAnlz32(&section, 12, stride);
+        putAnlz32(&section, 16, 2);
+        section += QByteArray(stride * 2, char(100));
+        putAnlz32(&section, 8, section.size());
+        analysis += section;
+    }
+    putAnlz32(&analysis, 8, analysis.size());
+    return analysis;
+}
