+TEST_F(Rx3BrowserLoadTest, MouseSelectsThenOpensAndTouchBackRestoresEachParentAndSelection) {
+    preparePlaylists();
+    const QModelIndex usb = devices.index(0, 0);
+    const QModelIndex folder = devices.index(0, 0, usb);
+    const QModelIndex nested = devices.index(0, 0, folder);
+    const QModelIndex playlist = devices.index(0, 0, nested);
+    for (const auto& index : {folder, nested, playlist}) {
+        if (!sidebar()->selectionModel()->isSelected(index)) {
+            const auto previousRoot = sidebar()->rootIndex();
+            QTest::mouseClick(sidebar()->viewport(), Qt::LeftButton, Qt::NoModifier,
+                    sidebar()->visualRect(index).center());
+            QCoreApplication::processEvents();
+            ASSERT_EQ(previousRoot, sidebar()->rootIndex());
+            ASSERT_TRUE(sidebar()->selectionModel()->isSelected(index));
+        }
+        QTest::mouseClick(sidebar()->viewport(), Qt::LeftButton, Qt::NoModifier,
+                sidebar()->visualRect(index).center());
+        QCoreApplication::processEvents();
+    }
+    ASSERT_TRUE(library->isVisible());
+    auto* back = button("RX3BrowserBack");
+    ASSERT_TRUE(back);
+    auto* title = button("RX3BrowserBreadcrumb");
+    for (const auto& selected : {playlist, nested, folder}) {
+        touchTap(back, back->rect().center());
+        EXPECT_TRUE(Rx3BrowserLoadTestAccess::inHierarchy(*browser));
+        EXPECT_FALSE(library->isVisible());
+        EXPECT_EQ(selected.parent(), sidebar()->rootIndex());
+        EXPECT_TRUE(sidebar()->selectionModel()->isSelected(selected));
+        EXPECT_EQ(selected.parent() == usb ? QStringLiteral("PLAYLIST")
+                                         : selected.parent().data().toString(), title->text());
+    }
+    EXPECT_EQ(1, playlists->activations);
+    touchTap(sidebar()->viewport(), sidebar()->visualRect(folder).center());
+    EXPECT_EQ(folder, sidebar()->rootIndex());
+}
