+TEST_F(Rx3BrowserLoadTest, TouchSelectsThenRepeatTapOpensWithoutRequiringDoubleTapTiming) {
+    preparePlaylists();
+    const QModelIndex usb = devices.index(0, 0);
+    const QModelIndex folder = devices.index(0, 0, usb);
+    const QModelIndex nested = devices.index(0, 0, folder);
+    const QModelIndex playlist = devices.index(0, 0, nested);
+    QSignalSpy loads1(load[0].get(), &ControlObject::valueChanged);
+    QSignalSpy loads2(load[1].get(), &ControlObject::valueChanged);
+    touchTap(sidebar()->viewport(), sidebar()->visualRect(folder).center());
+    ASSERT_EQ(usb, sidebar()->rootIndex());
+    ASSERT_TRUE(sidebar()->selectionModel()->isSelected(folder));
+    ASSERT_FALSE(library->isVisible());
+    EXPECT_EQ(0, playlists->activations);
+    QTest::qWait(QApplication::doubleClickInterval() + 50);
+    for (const auto& index : {folder, nested, playlist}) {
+        // Opening a folder preselects its first child. A tap on that existing
+        // selection opens it, including when the selection was restored by BACK.
+        touchTap(sidebar()->viewport(), sidebar()->visualRect(index).center());
+        if (index != playlist) {
+            EXPECT_EQ(index, sidebar()->rootIndex());
+            EXPECT_TRUE(Rx3BrowserLoadTestAccess::inHierarchy(*browser));
+        }
+    }
+    EXPECT_TRUE(library->isVisible());
+    EXPECT_FALSE(Rx3BrowserLoadTestAccess::inHierarchy(*browser));
+    EXPECT_EQ(1, playlists->activations);
+    EXPECT_EQ("Playlist", playlists->lastActivated);
+    table->clearSelection();
+    touchTap(table->viewport(), table->visualRect(rows.index(1, 0)).center());
+    EXPECT_TRUE(table->selectionModel()->isRowSelected(1, QModelIndex()));
+    EXPECT_TRUE(button("RX3BrowserLoad1")->isEnabled());
+    EXPECT_EQ(0, loads1.count());
+    EXPECT_EQ(0, loads2.count());
+}
