+    bool canLoadToDeck(int deck) const {
+        if (deck < 1 || deck > 2 || !selectedLoadTable()) return false;
+        const QString group = QStringLiteral("[Channel%1]").arg(deck);
+        if (!ControlObject::exists(ConfigKey(group, "LoadSelectedTrack"))) return false;
+        bool allowWhilePlaying = false;
+        if (m_config) {
+            if (m_config->exists(kConfigKeyLoadWhenDeckPlaying)) {
+                const auto mode = static_cast<LoadWhenDeckPlaying>(
+                        m_config->getValue<int>(kConfigKeyLoadWhenDeckPlaying));
+                allowWhilePlaying = mode == LoadWhenDeckPlaying::Allow ||
+                        mode == LoadWhenDeckPlaying::AllowButStopDeck;
+            } else {
+                allowWhilePlaying = m_config->getValue<bool>(kConfigKeyAllowTrackLoadToPlayingDeck);
+            }
+        }
+        return allowWhilePlaying || ControlObject::get(ConfigKey(group, "play")) <= 0 ||
+                ControlObject::get(ConfigKey(group, "rx3_source_lost")) > 0;
+    }
+
+    void updateLoadButtons() {
+        for (int deck = 1; deck <= 2; ++deck) {
+            auto* button = m_loadButtons[deck - 1];
+            if (!button) continue;
+            const bool ready = canLoadToDeck(deck);
+            button->setEnabled(ready);
+            button->setToolTip(ready ? QStringLiteral("Load selected track to deck %1").arg(deck)
+                    : !selectedLoadTable() ? QStringLiteral("Select a track first")
+                    : QStringLiteral("Deck %1 is unavailable or protected by Load Lock").arg(deck));
+        }
+    }
+
+    void loadSelectedToDeck(int deck) {
+        // Recheck at activation time; button state alone is not a load guard.
+        if (!canLoadToDeck(deck)) { updateLoadButtons(); return; }
