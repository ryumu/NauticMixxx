+#include <gtest/gtest.h>
+#include <QtTest>
+#include <QStandardItemModel>
+#include <QScreen>
+
+#include "control/controlpushbutton.h"
+#include "test/mixxxtest.h"
+#include "widget/wrx3browser.h"
+
+// Use a selection-only table: row painting and SQL/provider projection are
+// tested separately. The real hardware LOAD controls remain the boundary.
+class BrowserLoadTable : public WTrackTableView {
+  public:
+    explicit BrowserLoadTable(UserSettingsPointer config)
+            : WTrackTableView(nullptr, config, nullptr, 0.0) {}
+  protected:
+    void selectionChanged(const QItemSelection& selected, const QItemSelection& deselected) override {
+        QTableView::selectionChanged(selected, deselected);
+    }
+    void currentChanged(const QModelIndex& current, const QModelIndex& previous) override {
+        QTableView::currentChanged(current, previous);
+    }
+};
+
+struct Rx3BrowserLoadTestAccess {
+    static void tracks(WRx3Browser& browser) {
+        browser.m_pages->setCurrentIndex(0);
+        browser.m_level = WRx3Browser::BrowserLevel::Tracks;
+        browser.m_preview->hide();
+        browser.m_loading->hide();
+        browser.m_emptySpace->hide();
+        browser.m_library->show();
+        browser.refreshTable();
+    }
+    static void refresh(WRx3Browser& browser) { browser.updateLoadButtons(); }
+};
+
+class Rx3BrowserLoadTest : public MixxxTest {
+  protected:
+    void SetUp() override {
+        PlayerInfo::create();
+        tab = std::make_unique<ControlObject>(ConfigKey("[Tab]", "current"), false, false, false, 1);
+        maximized = std::make_unique<ControlObject>(ConfigKey("[Skin]", "show_maximized_library"), false, false, false, 1);
+        for (int deck = 1; deck <= 2; ++deck) {
+            const QString group = QStringLiteral("[Channel%1]").arg(deck);
+            play[deck - 1] = std::make_unique<ControlPushButton>(ConfigKey(group, "play"));
+            lost[deck - 1] = std::make_unique<ControlObject>(ConfigKey(group, "rx3_source_lost"));
+            load[deck - 1] = std::make_unique<ControlPushButton>(ConfigKey(group, "LoadSelectedTrack"));
+        }
+        config()->setValue(kConfigKeyLoadWhenDeckPlaying, int(LoadWhenDeckPlaying::Reject));
+        library = new WLibrary(nullptr);
+        table = new BrowserLoadTable(config());
+        rows.setRowCount(3); rows.setColumnCount(2);
+        for (int row = 0; row < 3; ++row) rows.setData(rows.index(row, 0), QStringLiteral("Track %1").arg(row));
+        table->setModel(&rows);
+        table->setSelectionBehavior(QAbstractItemView::SelectRows);
+        library->addWidget(table);
+        auto* sidebar = new WLibrarySidebar;
+        sidebar->setModel(&devices);
+        browser = std::make_unique<WRx3Browser>(library, sidebar, nullptr, nullptr, config());
+        QFile style(qEnvironmentVariable("NAUTIC_RX3_STYLESHEET"));
+        if (style.open(QIODevice::ReadOnly)) browser->setStyleSheet(QString::fromUtf8(style.readAll()));
+        browser->resize(1280, 690); browser->show();
+        QCoreApplication::processEvents();
+    }
+
+    void TearDown() override {
+        browser.reset();
+        PlayerInfo::destroy();
+    }
+
+    QPushButton* button(const QString& name) const {
+        return browser->findChild<QPushButton*>(name);
+    }
+    void selectTrack() {
+        Rx3BrowserLoadTestAccess::tracks(*browser);
+        table->selectRow(1);
+        QCoreApplication::processEvents();
+        Rx3BrowserLoadTestAccess::refresh(*browser);
+    }
+
+    QStandardItemModel rows;
+    SidebarModel devices;
+    WLibrary* library = nullptr;
+    BrowserLoadTable* table = nullptr;
+    std::unique_ptr<WRx3Browser> browser;
+    std::unique_ptr<ControlObject> tab, maximized;
+    std::array<std::unique_ptr<ControlPushButton>, 2> play, load;
+    std::array<std::unique_ptr<ControlObject>, 2> lost;
+};
+
+TEST_F(Rx3BrowserLoadTest, NoSelectionDisablesLoadsAndPerformanceDoesNotChangeTransport) {
+    auto* load1 = button("RX3BrowserLoad1");
+    auto* load2 = button("RX3BrowserLoad2");
+    auto* back = button("RX3BrowserPerformance");
+    ASSERT_TRUE(load1); ASSERT_TRUE(load2); ASSERT_TRUE(back);
+    EXPECT_FALSE(load1->isEnabled()); EXPECT_FALSE(load2->isEnabled());
+    QSignalSpy requests(load[0].get(), &ControlObject::valueChanged);
+    play[0]->set(1);
+    QTest::mouseClick(back, Qt::LeftButton);
+    EXPECT_EQ(0, tab->get()); EXPECT_EQ(0, maximized->get());
+    EXPECT_EQ(1, play[0]->get()); EXPECT_EQ(0, play[1]->get());
+    EXPECT_EQ(0, requests.count());
+}
+
+TEST_F(Rx3BrowserLoadTest, EachButtonPulsesOnlyItsNamedHardwareLoadAndKeepsSelection) {
+    selectTrack();
+    auto* load1 = button("RX3BrowserLoad1");
+    auto* load2 = button("RX3BrowserLoad2");
+    ASSERT_TRUE(load1->isEnabled()); ASSERT_TRUE(load2->isEnabled());
+    QSignalSpy requests1(load[0].get(), &ControlObject::valueChanged);
+    QSignalSpy requests2(load[1].get(), &ControlObject::valueChanged);
+    QTest::mouseClick(load1, Qt::LeftButton);
+    ASSERT_EQ(2, requests1.count()); EXPECT_EQ(0, requests2.count());
+    EXPECT_EQ(1, requests1.at(0).at(0).toDouble()); EXPECT_EQ(0, requests1.at(1).at(0).toDouble());
+    QTest::mouseClick(load2, Qt::LeftButton);
+    EXPECT_EQ(2, requests1.count()); ASSERT_EQ(2, requests2.count());
+    EXPECT_EQ(0, load[0]->get()); EXPECT_EQ(0, load[1]->get());
+    EXPECT_EQ(0, play[0]->get()); EXPECT_EQ(0, play[1]->get());
+    EXPECT_EQ(1, table->currentIndex().row()); EXPECT_EQ(1, tab->get());
+    table->clearSelection();
+    EXPECT_FALSE(load1->isEnabled()); EXPECT_FALSE(load2->isEnabled());
+}
+
+TEST_F(Rx3BrowserLoadTest, PlayingDeckIsProtectedAndGuardIsRecheckedOnActivation) {
+    selectTrack();
+    auto* load1 = button("RX3BrowserLoad1");
+    auto* load2 = button("RX3BrowserLoad2");
+    QSignalSpy requests(load[0].get(), &ControlObject::valueChanged);
+    play[0]->set(1);
+    EXPECT_FALSE(load1->isEnabled()); EXPECT_TRUE(load2->isEnabled());
+    // A queued click must not bypass a newly changed load policy/state.
+    ASSERT_TRUE(QMetaObject::invokeMethod(load1, "clicked", Qt::DirectConnection, Q_ARG(bool, false)));
+    EXPECT_EQ(0, requests.count());
+    config()->setValue(kConfigKeyLoadWhenDeckPlaying, int(LoadWhenDeckPlaying::Allow));
+    Rx3BrowserLoadTestAccess::refresh(*browser);
+    EXPECT_TRUE(load1->isEnabled());
+    QTest::mouseClick(load1, Qt::LeftButton);
+    EXPECT_EQ(2, requests.count());
+    config()->setValue(kConfigKeyLoadWhenDeckPlaying, int(LoadWhenDeckPlaying::Reject));
+    lost[0]->set(1);
+    EXPECT_TRUE(load1->isEnabled());
+}
+
+TEST_F(Rx3BrowserLoadTest, TouchReleaseLoadsOnceAndOutsideReleaseDoesNotLoad) {
+    selectTrack();
+    auto* load1 = button("RX3BrowserLoad1");
+    QSignalSpy requests(load[0].get(), &ControlObject::valueChanged);
+    auto* device = QTest::createTouchDevice(QInputDevice::DeviceType::TouchScreen);
+    const auto center = load1->rect().center();
+    // Native touch events use screen coordinates. The offscreen platform's
+    // virtual display may be narrower than the reference browser canvas.
+    const QRect screen = load1->screen()->geometry();
+    browser->QWidget::move(browser->pos() + screen.center() - load1->mapToGlobal(center));
+    QCoreApplication::processEvents();
+    ASSERT_TRUE(screen.contains(load1->mapToGlobal(center)));
+    ASSERT_TRUE(load1->isEnabled());
+    QTest::touchEvent(load1, device).press(0, center, load1);
+    QCoreApplication::processEvents();
+    EXPECT_EQ(0, requests.count());
+    QTest::touchEvent(load1, device).release(0, center, load1);
+    QCoreApplication::processEvents();
+    EXPECT_EQ(2, requests.count());
+    QTest::mousePress(load1, Qt::LeftButton);
+    QTest::mouseRelease(load1, Qt::LeftButton, Qt::NoModifier, QPoint(-10, -10));
+    EXPECT_EQ(2, requests.count());
+}
+
+TEST_F(Rx3BrowserLoadTest, PerformanceAndBrowseRoundTripPreservesSelectedTrackAndPlayback) {
+    selectTrack();
+    QObject::connect(tab.get(), &ControlObject::valueChanged, browser.get(), [this](double value) {
+        browser->setVisible(qRound(value) == 1);
+    });
+    play[1]->set(1);
+    QSignalSpy loads1(load[0].get(), &ControlObject::valueChanged);
+    QSignalSpy loads2(load[1].get(), &ControlObject::valueChanged);
+    QTest::mouseClick(button("RX3BrowserPerformance"), Qt::LeftButton);
+    EXPECT_EQ(0, tab->get()); EXPECT_FALSE(browser->isVisible());
+    ControlObject::set(ConfigKey("[RX3Browser]", "open"), 1);
+    ControlObject::set(ConfigKey("[RX3Browser]", "open"), 0);
+    QCoreApplication::processEvents();
+    EXPECT_EQ(1, tab->get()); EXPECT_TRUE(browser->isVisible());
+    EXPECT_EQ(1, table->currentIndex().row());
+    EXPECT_TRUE(table->selectionModel()->isRowSelected(1, QModelIndex()));
+    EXPECT_EQ(0, play[0]->get()); EXPECT_EQ(1, play[1]->get());
+    EXPECT_EQ(0, loads1.count()); EXPECT_EQ(0, loads2.count());
+}
+
+TEST_F(Rx3BrowserLoadTest, HeaderActionsRemainReachableAtReferenceAndPanelSizes) {
+    const QString output = qEnvironmentVariable("NAUTIC_BROWSER_LOAD_ARTIFACTS");
+    for (const auto size : {QSize(1280, 690), QSize(1920, 1090)}) {
+        browser->resize(size);
+        QCoreApplication::processEvents();
+        int rightEdge = 0;
+        for (const auto& name : {"RX3BrowserLoad1", "RX3BrowserLoad2", "RX3BrowserPerformance"}) {
+            auto* action = button(name);
+            ASSERT_TRUE(action);
+            const QPoint position = action->mapTo(browser.get(), QPoint());
+            EXPECT_GE(position.x(), rightEdge);
+            EXPECT_LE(position.x() + action->width(), browser->width());
+            EXPECT_GT(action->height(), 30);
+            rightEdge = position.x() + action->width();
+        }
+        if (!output.isEmpty()) {
+            ASSERT_TRUE(QDir().mkpath(output));
+            ASSERT_TRUE(browser->grab().save(QDir(output).filePath(
+                    QStringLiteral("browser-header-%1.png").arg(size.width()))));
+        }
+    }
+}
