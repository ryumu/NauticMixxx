diff --git a/src/test/rx3temporange_test.cpp b/src/test/rx3temporange_test.cpp
new file mode 100644
--- /dev/null
+++ b/src/test/rx3temporange_test.cpp
@@ -0,0 +1,103 @@
+#include <gtest/gtest.h>
+#include <QtTest>
+
+#include "control/controlpotmeter.h"
+#include "test/mixxxtest.h"
+#include "test/mockedenginebackendtest.h"
+#include "widget/wrx3performancewidgets.h"
+
+class Rx3TempoRangeTest : public MixxxTest {
+  protected:
+    QPushButton* hitArea(WRx3RangeBadge& badge) {
+        badge.resize(50, 20);
+        badge.show();
+        QCoreApplication::processEvents();
+        return badge.findChild<QPushButton*>(QStringLiteral("RX3TempoRangeCycle"));
+    }
+};
+
+TEST_F(Rx3TempoRangeTest, CyclesOnlyItsOwnDeckAndFollowsExternalChanges) {
+    ControlPotmeter range1(ConfigKey("[Channel1]", "rateRange"), 0.01, 4.0);
+    ControlPotmeter range2(ConfigKey("[Channel2]", "rateRange"), 0.01, 4.0);
+    range1.set(0.06);
+    range2.set(0.16);
+    WRx3RangeBadge badge1("[Channel1]"), badge2("[Channel2]");
+    auto* button1 = hitArea(badge1);
+    auto* button2 = hitArea(badge2);
+    ASSERT_TRUE(button1);
+    ASSERT_TRUE(button2);
+    QSignalSpy changes(&range1, &ControlObject::valueChanged);
+    for (const auto expected : {0.10, 0.16, 1.0, 0.06}) {
+        QTest::mouseClick(button1, Qt::LeftButton);
+        EXPECT_DOUBLE_EQ(expected, range1.get());
+        EXPECT_DOUBLE_EQ(0.16, range2.get());
+        EXPECT_EQ(expected == 0.06 ? 1 : expected == 0.16 ? 2 : expected >= 1 ? 3 : 0,
+                badge1.getHighlight());
+    }
+    EXPECT_EQ(4, changes.count());
+    range1.set(0.08);
+    QTest::mouseClick(button1, Qt::LeftButton);
+    EXPECT_DOUBLE_EQ(0.10, range1.get());
+    range1.set(0.50);
+    QTest::mouseClick(button1, Qt::LeftButton);
+    EXPECT_DOUBLE_EQ(1.0, range1.get());
+    EXPECT_EQ(QStringLiteral("WIDE"), button1->accessibleDescription());
+    QTest::mouseClick(button2, Qt::LeftButton);
+    EXPECT_DOUBLE_EQ(1.0, range2.get());
+    EXPECT_EQ(3, badge2.getHighlight());
+}
+
+TEST_F(Rx3TempoRangeTest, TouchTapAdvancesOnceOnRelease) {
+    ControlPotmeter range(ConfigKey("[Channel1]", "rateRange"), 0.01, 4.0);
+    range.set(0.06);
+    WRx3RangeBadge badge("[Channel1]");
+    auto* button = hitArea(badge);
+    ASSERT_TRUE(button);
+    auto* device = QTest::createTouchDevice(QInputDevice::DeviceType::TouchScreen);
+    const QPoint center = button->rect().center();
+    QSignalSpy changes(&range, &ControlObject::valueChanged);
+    QTest::touchEvent(button, device).press(0, center, button);
+    QCoreApplication::processEvents();
+    EXPECT_DOUBLE_EQ(0.06, range.get());
+    QTest::touchEvent(button, device).release(0, center, button);
+    QCoreApplication::processEvents();
+    EXPECT_DOUBLE_EQ(0.10, range.get());
+    EXPECT_EQ(1, changes.count());
+}
+
+TEST_F(Rx3TempoRangeTest, OutsideReleaseAndRightClickCancelAndResizedAreaRemainsClickable) {
+    ControlPotmeter range(ConfigKey("[Channel1]", "rateRange"), 0.01, 4.0);
+    range.set(0.06);
+    WRx3RangeBadge badge("[Channel1]");
+    auto* button = hitArea(badge);
+    ASSERT_TRUE(button);
+    QTest::mousePress(button, Qt::LeftButton);
+    QTest::mouseRelease(button, Qt::LeftButton, Qt::NoModifier, QPoint(-10, -10));
+    EXPECT_DOUBLE_EQ(0.06, range.get());
+    QTest::mouseClick(button, Qt::RightButton);
+    EXPECT_DOUBLE_EQ(0.06, range.get());
+    badge.resize(75, 30);
+    QCoreApplication::processEvents();
+    EXPECT_EQ(badge.rect(), button->geometry());
+    QTest::mouseClick(button, Qt::LeftButton, Qt::NoModifier, QPoint(70, 25));
+    EXPECT_DOUBLE_EQ(0.10, range.get());
+}
+
+class Rx3TempoRangeEngineTest : public MockedEngineBackendTest {};
+
+TEST_F(Rx3TempoRangeEngineTest, ChangingRangePreservesPlaybackRateInTheRealEngine) {
+    const ConfigKey range(m_sGroup1, "rateRange"), ratio(m_sGroup1, "rate_ratio");
+    ControlObject::set(range, 0.06);
+    ControlObject::set(ratio, 1.025);
+    WRx3RangeBadge badge(m_sGroup1);
+    badge.resize(50, 20);
+    badge.show();
+    QCoreApplication::processEvents();
+    auto* button = badge.findChild<QPushButton*>(QStringLiteral("RX3TempoRangeCycle"));
+    ASSERT_TRUE(button);
+    for (const auto expected : {0.10, 0.16, 1.0, 0.06}) {
+        QTest::mouseClick(button, Qt::LeftButton);
+        EXPECT_DOUBLE_EQ(expected, ControlObject::get(range));
+        EXPECT_NEAR(1.025, ControlObject::get(ratio), 1e-12);
+    }
+}
