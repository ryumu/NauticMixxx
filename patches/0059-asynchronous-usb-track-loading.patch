+void RekordboxUsbSession::requestTemporaryTrack(std::shared_ptr<RekordboxUsbSession> session,
+        quint32 rekordboxId, QObject* context, std::function<void(TrackPointer)> ready,
+        const QString& requestKey) {
+    if (!context) return;
+    // Requests and completions run on the GUI thread. Share deck tickets with
+    // CONTINUE so its older pending load cannot replace a newer manual choice.
+    static QHash<QString, std::weak_ptr<std::atomic<bool>>> pendingRequests;
+    const auto cancelled = std::make_shared<std::atomic<bool>>(false);
+    if (!requestKey.isEmpty()) {
+        if (const auto previous = pendingRequests.value(requestKey).lock()) previous->store(true);
+        pendingRequests[requestKey] = cancelled;
+    }
+    auto* watcher = new QFutureWatcher<TrackPointer>(context);
+    QObject::connect(context, &QObject::destroyed, watcher, [cancelled] { cancelled->store(true); });
+    QObject::connect(watcher, &QFutureWatcher<TrackPointer>::finished, context,
+            [watcher, ready = std::move(ready), cancelled] {
+                auto track = watcher->result();
+                watcher->deleteLater();
+                if (cancelled->load()) return;
+                if (track && !track->isSourceAvailableForPlayback()) track.reset();
+                ready(std::move(track));
+            });
+    auto* guiThread = QCoreApplication::instance()->thread();
+    watcher->setFuture(QtConcurrent::run([session = std::move(session), rekordboxId, guiThread, cancelled] {
+        auto track = session ? session->createTemporaryTrack(rekordboxId, nullptr, cancelled) : TrackPointer();
+        // Like GlobalTrackCache, move newly created QObjects off the worker
+        // before delivery; pool threads have no event loop for Track slots.
+        if (track) track->moveToThread(guiThread);
+        return track;
+    }));
+}
