+    int loads = 0;
+    rx3::TouchPreview preview([&](TrackPointer) { ++loads; });
+    const auto released = preview.beginRequest(.2);
+    preview.completed({});
+    EXPECT_EQ(0, play.get());
+    preview.cancel();
+    preview.supply(released, track, {});
+    EXPECT_EQ(0, loads);
+    const auto stale = preview.beginRequest(.3);
+    const auto current = preview.beginRequest(.4);
+    preview.supply(stale, track, {});
+    EXPECT_EQ(0, loads);
+    preview.move(.9);
+    preview.supply(current, track, {});
+    EXPECT_EQ(1, loads);
+    EXPECT_EQ(0, play.get());
+    preview.completed(track);
+    EXPECT_EQ(1, play.get());
+    EXPECT_DOUBLE_EQ(.9, position.get());
+    preview.cancel();
+}
