+#pragma once
+
+#include <QByteArray>
+#include <QDir>
+#include <QFileInfo>
+#include <QHash>
+#include <QSet>
+#include <QStringList>
+
+namespace mixxx::rekordbox {
+// Only inspect explicit mount roots and immediate legacy mount children.
+// Never recursively search the system disk for exported libraries.
+inline QStringList discoveryPaths(const QStringList& mountedRoots,
+        const QStringList& legacyDirectories) {
+    QStringList candidates = mountedRoots;
+    for (const auto& directory : legacyDirectories) {
+        if (directory.isEmpty()) continue;
+        const auto children = QDir(directory).entryInfoList(QDir::AllDirs | QDir::NoDotAndDotDot);
+        for (const auto& child : children) candidates.append(child.absoluteFilePath());
+    }
+    QStringList result;
+    QSet<QString> seen;
+    for (const auto& candidate : candidates) {
+        const QFileInfo file(candidate);
+        if (candidate.isEmpty() || !file.isDir()) continue;
+        const auto canonical = file.canonicalFilePath();
+        if (canonical.isEmpty() || canonical == QStringLiteral("/") || seen.contains(canonical)) continue;
+        seen.insert(canonical);
+        result.append(canonical);
+    }
+    return result;
+}
+
+inline QStringList changedMountRoots(const QStringList& previousRoots,
+        const QStringList& currentRoots,
+        const QHash<QString, QByteArray>& previousIdentities,
+        const QHash<QString, QByteArray>& currentIdentities) {
+    QStringList changed;
+    for (const auto& root : previousRoots) {
+        if (!currentRoots.contains(root) || previousIdentities.value(root) != currentIdentities.value(root)) {
+            changed.append(root);
+        }
+    }
+    return changed;
+}
+} // namespace mixxx::rekordbox
