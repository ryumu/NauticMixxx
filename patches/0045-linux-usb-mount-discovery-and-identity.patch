+QList<DiscoveredDevice> discoverDevices(const QStringList& candidates) {
+    QList<DiscoveredDevice> found;
+    QSet<QString> seen;
+    for (const auto& candidate : candidates) {
+        if (databasePath(candidate).isEmpty()) continue;
+        auto snapshot = inspectDevice(candidate);
+        if (snapshot.root.isEmpty() || seen.contains(snapshot.root)) continue;
+        seen.insert(snapshot.root);
+        const QFileInfo device(candidate);
+        const auto label = device.fileName().isEmpty() ? candidate : device.fileName();
+        found.append({label, std::move(snapshot)});
+    }
+    return found;
+}
+
 bool DeviceSnapshot::matches(const DeviceSnapshot& other) const {
     return state == DeviceState::Readable && other.state == DeviceState::Readable &&
             root == other.root && mountIdentity == other.mountIdentity && fingerprint == other.fingerprint;
