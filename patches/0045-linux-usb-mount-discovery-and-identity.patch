+#include "util/rx3usbstorage.h"
+
+namespace {
+using namespace mixxx::rekordbox;
+
+void marker(const QString& root) {
+    ASSERT_TRUE(QDir().mkpath(root + "/PIONEER/rekordbox"));
+    QFile file(root + "/PIONEER/rekordbox/export.pdb");
+    ASSERT_TRUE(file.open(QIODevice::WriteOnly));
+    ASSERT_EQ(7, file.write("fixture"));
+}
+} // namespace
+
+TEST(RekordboxDiscoveryTest, CustomMountedRootIsDiscoveredWithoutLegacyDirectory) {
+    QTemporaryDir base;
+    ASSERT_TRUE(base.isValid());
+    const auto fixedMount = base.filePath("mnt/DJ USB");
+    marker(fixedMount);
+    const auto paths = discoveryPaths({fixedMount}, {base.filePath("absent-media")});
+    const auto found = discoverDevices(paths);
+    ASSERT_EQ(1, found.size());
+    EXPECT_EQ(QFileInfo(fixedMount).canonicalFilePath(), found.front().snapshot.root);
+    EXPECT_EQ(DeviceState::Readable, found.front().snapshot.state);
+    EXPECT_EQ(QStringLiteral("DJ USB"), found.front().label);
+}
+
+TEST(RekordboxDiscoveryTest, LegacyChildrenAreRetainedAndAliasesDeduplicated) {
+    QTemporaryDir base;
+    ASSERT_TRUE(base.isValid());
+    const auto volume = base.filePath("media/USB");
+    marker(volume);
+#ifndef Q_OS_WIN
+    ASSERT_TRUE(QFile::link(volume, base.filePath("alias")));
+    const auto mounts = QStringList{volume, base.filePath("alias"), volume};
+#else
+    const auto mounts = QStringList{volume, volume};
+#endif
+    const auto paths = discoveryPaths(mounts, {base.filePath("media")});
+    EXPECT_EQ(1, paths.size());
+    EXPECT_EQ(1, discoverDevices(paths).size());
+}
+
+TEST(RekordboxDiscoveryTest, RootDiskAndRecursiveLocalFoldersAreNotSearched) {
+    QTemporaryDir base;
+    ASSERT_TRUE(base.isValid());
+    marker(base.filePath("media/parent/nested"));
+    const auto paths = discoveryPaths({"/", "", base.filePath("missing")},
+            {base.filePath("media"), ""});
+    EXPECT_FALSE(paths.contains("/"));
+    EXPECT_FALSE(paths.contains(base.filePath("media/parent/nested")));
+    EXPECT_TRUE(discoverDevices(paths).isEmpty());
+}
+
+TEST(RekordboxDiscoveryTest, ExportSymlinkOutsideTheMountIsRejected) {
+#ifdef Q_OS_WIN
+    GTEST_SKIP() << "Windows symlink creation requires additional privileges";
+#else
+    QTemporaryDir volume;
+    QTemporaryDir outside;
+    ASSERT_TRUE(volume.isValid());
+    ASSERT_TRUE(outside.isValid());
+    marker(outside.path());
+    ASSERT_TRUE(QFile::link(outside.path() + "/PIONEER", volume.filePath("PIONEER")));
+    EXPECT_TRUE(discoverDevices({volume.path()}).isEmpty());
+#endif
+}
+
+TEST(RekordboxDiscoveryTest, ReplacementAtTheSamePathAndRemovalRevokeOldRoots) {
+    const QString first = "/mnt/usb1";
+    const QString second = "/mnt/usb2";
+    const QString third = "/mnt/usb3";
+    const QHash<QString, QByteArray> previous{{first, "device:mount:1:disk:10"},
+            {second, "device:mount:2:disk:20"}, {third, "device:mount:3:disk:30"}};
+    const QHash<QString, QByteArray> current{{first, "device:mount:1:disk:11"},
+            {second, "device:mount:2:disk:20"}};
+    EXPECT_EQ(QStringList({first, third}), changedMountRoots({first, second, third},
+            {first, second}, previous, current));
+    EXPECT_TRUE(changedMountRoots({first}, {first}, previous, previous).isEmpty());
+    EXPECT_EQ(QStringList({first}), changedMountRoots({first}, {first}, previous, {}));
+}
+
+TEST(RekordboxDiscoveryTest, MatchingExportOnAReplacementMountIsNotTheSameDevice) {
+    QTemporaryDir volume;
+    ASSERT_TRUE(volume.isValid());
+    marker(volume.path());
+    const auto original = inspectDevice(volume.path());
+    ASSERT_EQ(DeviceState::Readable, original.state);
+    auto replacement = original;
+    replacement.mountIdentity.append(":replacement-generation");
+    EXPECT_FALSE(original.matches(replacement));
+    EXPECT_TRUE(original.matches(inspectDevice(volume.path())));
+}
+
+#ifdef Q_OS_LINUX
+TEST(RekordboxLinuxMountTest, FdInfoParsingIsStrictAndIgnoresUnrelatedFields) {
+    EXPECT_EQ(QByteArray("42"), rx3::mountIdFromFdInfo("pos:\t0\nflags:\t010000000\nmnt_id:\t42\nino:\t1\n"));
+    for (const auto& invalid : {QByteArray(), QByteArray("mnt_id:\t0\n"),
+                 QByteArray("mnt_id:\t-1\n"), QByteArray("mnt_id:\t42garbage\n"),
+                 QByteArray("mnt_id:\t18446744073709551616\n")}) {
+        EXPECT_TRUE(rx3::mountIdFromFdInfo(invalid).isEmpty());
+    }
+}
+
+TEST(RekordboxLinuxMountTest, ExistingMountIdentityIsStableAndFailuresAreClosed) {
+    QTemporaryDir volume;
+    ASSERT_TRUE(volume.isValid());
+    const auto canonical = QFileInfo(volume.path()).canonicalFilePath();
+    const auto device = QStorageInfo(canonical).device();
+    const auto first = rx3::linuxMountIdentity(canonical, device);
+    ASSERT_FALSE(first.isEmpty());
+    EXPECT_EQ(first, rx3::linuxMountIdentity(canonical, device));
+    EXPECT_TRUE(first.contains(":mount:") || first.contains(":unique-mount:"));
+    EXPECT_TRUE(rx3::linuxMountIdentity(volume.filePath("missing"), device).isEmpty());
+    EXPECT_TRUE(rx3::linuxMountIdentity(canonical, {}).isEmpty());
+}
+
+TEST(RekordboxLinuxMountTest, IdentityChecksDoNotLeakFileDescriptors) {
+    QTemporaryDir volume;
+    ASSERT_TRUE(volume.isValid());
+    const auto canonical = QFileInfo(volume.path()).canonicalFilePath();
+    // Exercise the fdinfo path even when the host uses unique mount IDs.
+    const QByteArray device("virtual-test-volume");
+    const QByteArray sequence;
+    const auto legacy = rx3::legacyLinuxMountIdentity(canonical, device, sequence);
+    ASSERT_FALSE(legacy.isEmpty());
+    EXPECT_TRUE(legacy.contains(":mount:"));
+    EXPECT_TRUE(rx3::legacyLinuxMountIdentity(volume.filePath("missing"), device, sequence).isEmpty());
+    EXPECT_TRUE(rx3::legacyLinuxMountIdentity(canonical, "/dev/nauticmixxx-missing-fixture", {}).isEmpty());
+    const auto before = QDir("/proc/self/fd").entryList(QDir::AllEntries | QDir::NoDotAndDotDot).size();
+    for (int iteration = 0; iteration < 100; ++iteration) {
+        ASSERT_FALSE(rx3::linuxMountIdentity(canonical, device).isEmpty());
+        EXPECT_EQ(legacy, rx3::legacyLinuxMountIdentity(canonical, device, sequence));
+    }
+    EXPECT_EQ(before, QDir("/proc/self/fd").entryList(QDir::AllEntries | QDir::NoDotAndDotDot).size());
+}
+
+TEST(RekordboxLinuxMountTest, PartitionGenerationComesFromTheParentDisk) {
+    QTemporaryDir sysfs;
+    ASSERT_TRUE(sysfs.isValid());
+    ASSERT_TRUE(QDir().mkpath(sysfs.filePath("disk/partition")));
+    QFile generation(sysfs.filePath("disk/diskseq"));
+    ASSERT_TRUE(generation.open(QIODevice::WriteOnly));
+    ASSERT_EQ(4, generation.write("123\n"));
+    generation.close();
+    EXPECT_EQ(QByteArray("123"), rx3::diskSequenceFromSysfs(sysfs.filePath("disk/partition")));
+    EXPECT_EQ(QByteArray("123"), rx3::diskSequenceFromSysfs(sysfs.filePath("disk")));
+    ASSERT_TRUE(generation.open(QIODevice::WriteOnly | QIODevice::Truncate));
+    generation.write("not-a-generation\n");
+    generation.close();
+    EXPECT_TRUE(rx3::diskSequenceFromSysfs(sysfs.filePath("disk/partition")).isEmpty());
+}
+#endif
diff --git a/src/util/linuxmountidentity.h b/src/util/linuxmountidentity.h
new file mode 100644
--- /dev/null
+++ b/src/util/linuxmountidentity.h
@@ -0,0 +1,90 @@
+#pragma once
+
+#include <QByteArray>
+#include <QFile>
+#include <QFileInfo>
+#include <QString>
+
+#ifdef Q_OS_LINUX
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <sys/sysmacros.h>
+#include <unistd.h>
+
+namespace rx3 {
+inline QByteArray positiveKernelNumber(const QByteArray& value) {
+    const auto text = value.trimmed();
+    if (text.isEmpty()) return {};
+    for (const char character : text) {
+        if (character < '0' || character > '9') return {};
+    }
+    bool valid = false;
+    const auto number = text.toULongLong(&valid);
+    return valid && number > 0 ? QByteArray::number(number) : QByteArray();
+}
+
+inline QByteArray mountIdFromFdInfo(const QByteArray& info) {
+    for (const auto& line : info.split('\n')) {
+        if (line.startsWith("mnt_id:")) return positiveKernelNumber(line.mid(7));
+    }
+    return {};
+}
+
+inline QByteArray diskSequenceFromSysfs(QString directory) {
+    // A partition keeps diskseq on its parent disk, not on the partition.
+    for (int level = 0; level < 2 && !directory.isEmpty(); ++level) {
+        QFile file(directory + QStringLiteral("/diskseq"));
+        if (file.open(QIODevice::ReadOnly)) return positiveKernelNumber(file.readAll());
+        directory = QFileInfo(directory).absolutePath();
+    }
+    return {};
+}
+
+inline QByteArray diskSequence(const QByteArray& device) {
+    struct stat status{};
+    if (::stat(device.constData(), &status) != 0 || !S_ISBLK(status.st_mode)) return {};
+    const QString link = QStringLiteral("/sys/dev/block/%1:%2")
+            .arg(major(status.st_rdev)).arg(minor(status.st_rdev));
+    return diskSequenceFromSysfs(QFileInfo(link).canonicalFilePath());
+}
+
+inline QByteArray legacyLinuxMountIdentity(const QString& path, const QByteArray& device,
+        const QByteArray& sequence) {
+    if (path.isEmpty() || device.isEmpty()) return {};
+    const auto encoded = QFile::encodeName(path);
+    // Older kernels: combine the mount ID with the kernel's disk sequence.
+    // This distinguishes a new USB disk assigned the old /dev/sdX name.
+    // The descriptor is short lived, so a normal unmount remains possible.
+    const int descriptor = ::open(encoded.constData(), O_PATH | O_CLOEXEC);
+    if (descriptor < 0) return {};
+    QFile info(QStringLiteral("/proc/self/fdinfo/%1").arg(descriptor));
+    const auto mount = info.open(QIODevice::ReadOnly)
+            ? mountIdFromFdInfo(info.readAll()) : QByteArray();
+    ::close(descriptor);
+    if (mount.isEmpty()) return {};
+    struct stat block{};
+    // A removable block device must have a generation identifier. Refuse
+    // weak identities when diskseq cannot be read on an older kernel.
+    const bool blockPresent = ::stat(device.constData(), &block) == 0 && S_ISBLK(block.st_mode);
+    if ((device.startsWith("/dev/") && !blockPresent) || (blockPresent && sequence.isEmpty())) return {};
+    return device + ":mount:" + mount + ":disk:" + sequence;
+}
+
+inline QByteArray linuxMountIdentity(const QString& path, const QByteArray& device) {
+    if (path.isEmpty() || device.isEmpty()) return {};
+    const auto encoded = QFile::encodeName(path);
+    const auto sequence = diskSequence(device);
+    // Linux 6.8+ returns an ID never reused during the lifetime of the kernel.
+    // Use the ABI value so Debian 12's older headers can still compile this.
+    constexpr unsigned int mountIdMask = 0x1000;
+    constexpr unsigned int uniqueMountIdMask = 0x4000;
+    struct statx status{};
+    if (::statx(AT_FDCWD, encoded.constData(), AT_NO_AUTOMOUNT,
+                mountIdMask | uniqueMountIdMask, &status) == 0 &&
+            (status.stx_mask & uniqueMountIdMask) != 0 && status.stx_mnt_id > 0) {
+        return device + ":unique-mount:" + QByteArray::number(status.stx_mnt_id) + ":disk:" + sequence;
+    }
+    return legacyLinuxMountIdentity(path, device, sequence);
+}
+} // namespace rx3
+#endif
