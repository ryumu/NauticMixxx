+int RekordboxUsbSession::prefetchTrackAnalyses(const QList<quint32>& ids,
+        std::shared_ptr<const std::atomic<bool>> cancelled) {
+    const std::unique_lock<std::mutex> analysisLock(m_analysisMutex, std::try_to_lock);
+    if (!analysisLock.owns_lock() || m_foregroundAnalysisRequests.load() > 0) return 0;
+    std::shared_ptr<RuntimeCatalog> catalog;
+    QString root;
+    {
+        const std::lock_guard<std::mutex> lock(m_mutex);
+        if (m_state != UsbSessionState::Ready || !m_catalog || !m_sessionState->isActive()) return 0;
+        catalog = m_catalog;
+        root = m_root;
+    }
+    QList<RuntimeTrack> inspected;
+    QElapsedTimer workTime;
+    workTime.start();
+    int completed = 0;
+    for (const auto id : ids) {
+        if (completed >= kAnalysisPrefetchBatchSize || m_foregroundAnalysisRequests.load() > 0 ||
+                !m_sessionState->isActive() || (cancelled && cancelled->load()) ||
+                (!inspected.isEmpty() && workTime.elapsed() >= 8)) break;
+        auto track = catalog->findTrack(id);
+        if (track && track->analysisState == RuntimeAnalysisState::Unknown) {
+            // Verify the whole batch before reading its first ANLZ and again
+            // before publishing. Cached metadata alone initiates no USB I/O.
+            if (inspected.isEmpty()) {
+                if (!refresh()) return 0;
+                workTime.restart();
+            }
+            applyAnlz(root, m_sessionId, &*track);
+            inspected.append(std::move(*track));
+        }
+        ++completed;
+    }
+    if (inspected.isEmpty()) return completed;
+    if (!refresh()) return 0;
+    const std::lock_guard<std::mutex> lock(m_mutex);
+    if (m_state != UsbSessionState::Ready || m_catalog != catalog || !m_sessionState->isActive()) return 0;
+    for (const auto& track : inspected) {
+        if (!catalog->publishAnalysis(track)) return 0;
+    }
+    return completed;
 }
 
