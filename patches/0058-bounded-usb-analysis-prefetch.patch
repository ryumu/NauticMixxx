+void RekordboxRuntimeTrackModel::startNextAnalysisRead() {
+    QList<quint32> ids;
+    const auto catalog = m_session->catalog();
+    // Publish the first row promptly so painting can prioritize its preview.
+    const int batchSize = m_analysisPrefetchStarted ? RekordboxUsbSession::kAnalysisPrefetchBatchSize : 1;
+    while (!m_analysisRequests.isEmpty() && ids.size() < batchSize) {
+        const auto id = m_analysisRequests.dequeue();
+        const auto track = catalog ? catalog->findTrack(id) : std::nullopt;
+        if (track && track->analysisState == RuntimeAnalysisState::Unknown) ids.append(id);
+    }
+    if (ids.isEmpty()) return;
+    m_analysisPrefetchStarted = true;
+    const auto cancelled = std::make_shared<std::atomic<bool>>(false);
+    m_analysisCancelled = cancelled;
+    const auto session = m_session;
+    const auto generation = m_previewGeneration;
+    m_previewReadRunning = true;
+    auto* watcher = new QFutureWatcher<int>(this);
+    connect(watcher, &QFutureWatcher<int>::finished, this, [this, watcher, ids, generation] {
+        const int completed = watcher->result();
+        watcher->deleteLater();
+        m_previewReadRunning = false;
+        const auto state = sessionState();
+        if (generation == m_previewGeneration && state && state->isActive()) {
+            for (int i = ids.size() - 1; i >= completed; --i) m_analysisRequests.prepend(ids[i]);
+            const int column = fieldIndex(ColumnCache::COLUMN_LIBRARYTABLE_PREVIEW);
+            for (int i = 0; i < completed && generation == m_previewGeneration; ++i) {
+                const auto rows = m_rowsByTrackId.value(ids[i]);
+                for (const auto row : rows) {
+                    if (generation != m_previewGeneration) break;
+                    if (column >= 0) emit dataChanged(index(row, column), index(row, column));
+                }
+            }
+        }
+        schedulePreviewRead();
+    });
+    watcher->setFuture(QtConcurrent::run([session, ids, cancelled] { return session->prefetchTrackAnalyses(ids, cancelled); }));
 }
 
