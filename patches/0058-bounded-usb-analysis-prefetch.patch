+TEST(RekordboxUsbSessionTest, BoundedBackgroundBatchesCancelAndKeepExplicitFingerprintChecks) {
+    QTemporaryDir volume;
+    Rows data;
+    QList<quint32> ids;
+    for (quint32 id = 1; id <= 40; ++id) {
+        const auto owner = QString("/Contents/%1.mp3").arg(id);
+        const auto analysis = QString("/PIONEER/USBANLZ/%1.DAT").arg(id);
+        data.append({0, track(id, owner.toUtf8(), analysis.toUtf8())});
+        ASSERT_TRUE(write(volume.path() + analysis, syntheticCueAnlz(owner)));
+        ids.append(id);
+    }
+    ASSERT_TRUE(write(pdb(volume), database(data)));
+    RekordboxUsbSession session(volume.path());
+    ASSERT_TRUE(session.load());
+    const auto catalog = session.catalog();
+    const auto cancelled = std::make_shared<std::atomic<bool>>(true);
+    EXPECT_EQ(0, session.prefetchTrackAnalyses(ids, cancelled));
+    EXPECT_EQ(RuntimeAnalysisState::Unknown, catalog->findTrack(1)->analysisState);
+    int completed = 0;
+    while (completed < ids.size()) {
+        const int count = session.prefetchTrackAnalyses(ids.mid(completed));
+        ASSERT_GT(count, 0);
+        ASSERT_LE(count, RekordboxUsbSession::kAnalysisPrefetchBatchSize);
+        completed += count;
+        for (int i = 0; i < completed; ++i) {
+            ASSERT_EQ(RuntimeAnalysisState::Ready, catalog->findTrack(ids[i])->analysisState);
+            ASSERT_EQ(4, catalog->findTrack(ids[i])->cues.size());
+        }
+        if (completed < ids.size()) EXPECT_EQ(RuntimeAnalysisState::Unknown, catalog->findTrack(ids[completed])->analysisState);
+    }
+    // Reusing metadata does not weaken explicit-load source validation, even
+    // if a PDB edit preserves both its byte length and modification timestamp.
+    QFile changed(pdb(volume));
+    ASSERT_TRUE(changed.open(QIODevice::ReadWrite));
+    const auto modified = QFileInfo(changed).lastModified();
+    ASSERT_TRUE(changed.seek(changed.size() - 1));
+    ASSERT_EQ(1, changed.write("x", 1));
+    ASSERT_TRUE(changed.flush());
+    ASSERT_TRUE(changed.setFileTime(modified, QFileDevice::FileModificationTime));
+    changed.close();
+    QString error;
+    EXPECT_FALSE(session.loadTrackAnalysis(1, &error));
+    EXPECT_FALSE(error.isEmpty());
+    EXPECT_EQ(UsbSessionState::Invalidated, session.state());
+    EXPECT_EQ(0, session.prefetchTrackAnalyses(ids));
+}
