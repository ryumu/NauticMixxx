+// These lightweight platform queries run only every five seconds on the GUI
+// thread. No audio, artwork, or USB files are opened here.
+QPair<quint64, quint64> browserMemoryBytes() {
+#if defined(Q_OS_LINUX)
+    QFile info(QStringLiteral("/proc/meminfo"));
+    quint64 total = 0, available = 0;
+    if (info.open(QIODevice::ReadOnly)) {
+        const auto lines = info.readAll().split('\n');
+        for (const auto& line : lines) {
+            const auto fields = line.simplified().split(' ');
+            if (fields.size() < 2) continue;
+            if (fields[0] == "MemTotal:") total = fields[1].toULongLong() * 1024;
+            if (fields[0] == "MemAvailable:") available = fields[1].toULongLong() * 1024;
+        }
+    }
+    return {total, available};
+#elif defined(Q_OS_WIN)
+    MEMORYSTATUSEX status{};
+    status.dwLength = sizeof(status);
+    if (GlobalMemoryStatusEx(&status)) return {status.ullTotalPhys, status.ullAvailPhys};
+#elif defined(Q_OS_MACOS)
+    quint64 total = 0;
+    size_t size = sizeof(total);
+    vm_statistics64_data_t stats{};
+    mach_msg_type_number_t count = HOST_VM_INFO64_COUNT;
+    const auto host = mach_host_self();
+    vm_size_t pageSize = 0;
+    const bool valid = sysctlbyname("hw.memsize", &total, &size, nullptr, 0) == 0 &&
+            host_page_size(host, &pageSize) == KERN_SUCCESS &&
+            host_statistics64(host, HOST_VM_INFO64, reinterpret_cast<host_info64_t>(&stats), &count) == KERN_SUCCESS;
+    mach_port_deallocate(mach_task_self(), host);
+    if (valid) return {total, (quint64(stats.free_count) + stats.inactive_count) * pageSize};
+#endif
+    return {};
+}
+
 } // namespace
