+TEST_F(RekordboxRuntimeTrackModelTest, RetainsMoreThan128PreviewsAcrossListsAndBrowserExit) {
+    QTemporaryDir volume;
+    Rows data;
+    for (int id = 1; id <= 160; ++id) {
+        const auto owner = QStringLiteral("/Contents/%1.mp3").arg(id);
+        const auto path = QStringLiteral("/PIONEER/USBANLZ/%1.DAT").arg(id);
+        data.append({0, track(id, owner.toUtf8(), path.toUtf8())});
+        ASSERT_TRUE(write(volume.path() + path, syntheticBrowserPreview(owner)));
+    }
+    ASSERT_TRUE(write(pdb(volume), database(data)));
+    auto session = std::make_shared<RekordboxUsbSession>(volume.path());
+    ASSERT_TRUE(session->load());
+    RekordboxRuntimeTrackModel model(nullptr, trackCollectionManager());
+    model.showAllTracks(session);
+    for (int row = 0; row < model.rowCount(); ++row)
+        model.requestWaveformPreview(model.index(row, 0), WaveformMode::ThreeBand);
+    ASSERT_TRUE(waitForBrowserPreview([&] {
+        return model.waveformPreview(model.index(159, 0), WaveformMode::ThreeBand) != nullptr;
+    }));
+    const auto* first = model.waveformPreview(model.index(0, 0), WaveformMode::ThreeBand);
+    ASSERT_NE(nullptr, first);
+    EXPECT_EQ(2, first->columns.size());
+    model.showPlaylist(session, {160, 1, 1}, 42);
+    EXPECT_EQ(first, model.waveformPreview(model.index(1, 0), WaveformMode::ThreeBand));
+    model.clearSession();
+    EXPECT_EQ(0, model.rowCount());
+    model.showTrackIds(session, {1}, QStringLiteral("search"));
+    EXPECT_EQ(first, model.waveformPreview(model.index(0, 0), WaveformMode::ThreeBand));
+    // Switching devices with equal numeric IDs must not reuse the other USB.
+    auto second = std::make_shared<RekordboxUsbSession>(volume.path());
+    ASSERT_TRUE(second->load());
+    model.showAllTracks(second);
