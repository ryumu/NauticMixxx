+int RekordboxRuntimeTrackModel::browserCacheBudgetKiB(quint64 totalBytes, quint64 availableBytes) {
+    if (!totalBytes) return 16 * 1024;
+    constexpr quint64 reserve = 128 * 1024 * 1024;
+    if (availableBytes <= reserve) return 0;
+    const int budget = int(std::min({quint64(256 * 1024), totalBytes / (64 * 1024),
+            (availableBytes - reserve) / (16 * 1024)}));
+    // Keep both partitions large enough for at least one bounded thumbnail;
+    // an entry larger than its cache would otherwise trigger repeated reads.
+    return budget >= 512 ? budget : 0;
+}
+
+void RekordboxRuntimeTrackModel::refreshBrowserCacheBudget() {
+    const auto memory = browserMemoryBytes();
+    const int budget = browserCacheBudgetKiB(memory.first, memory.second);
+    // Artwork gets one quarter; both LRU caches account for actual decoded
+    // storage and a minimum entry cost (including missing/corrupt results).
+    m_waveformPreviewCache.setMaxCost(budget * 3 / 4);
+    m_artworkPreviewCache.setMaxCost(budget / 4);
+    for (auto it = m_cachedSessions.begin(); it != m_cachedSessions.end();) {
+        const auto state = it.value().lock();
+        if (state && state->isActive()) { ++it; continue; }
+        for (const auto& key : m_waveformPreviewCache.keys()) {
+            if (key.startsWith(it.key())) m_waveformPreviewCache.remove(key);
+        }
+        for (const auto& key : m_artworkPreviewCache.keys()) {
+            if (key.startsWith(it.key())) m_artworkPreviewCache.remove(key);
+        }
+        it = m_cachedSessions.erase(it);
+    }
+}
+
+QString RekordboxRuntimeTrackModel::previewCacheKey(quint32 id, int variant) const {
+    return m_cacheSessionPrefix + QString::number(quint64(id) * 3 + variant);
+}
 
