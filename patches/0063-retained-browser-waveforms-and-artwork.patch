+TEST_F(RekordboxRuntimeTrackModelTest, BrowserArtworkRendersThroughProxyAndSurvivesNavigation) {
+    QTemporaryDir volume;
+    auto song = track();
+    put32(&song, 28, 7);
+    QByteArray artworkRow(4, '\0');
+    put32(&artworkRow, 0, 7);
+    ASSERT_TRUE(write(pdb(volume), database({{0, song}, {0, track(2, "/Contents/second.mp3", "/PIONEER/USBANLZ/second.DAT")},
+            {13, artworkRow + text("/PIONEER/art.png")}})));
+    QImage source(800, 400, QImage::Format_RGB32);
+    source.fill(Qt::red);
+    ASSERT_TRUE(source.save(volume.filePath("PIONEER/art.png")));
+    auto session = std::make_shared<RekordboxUsbSession>(volume.path());
+    ASSERT_TRUE(session->load());
+    RekordboxRuntimeTrackModel model(nullptr, trackCollectionManager());
+    model.showAllTracks(session);
+    ASSERT_EQ(2, model.rowCount());
+    ProxyTrackModel proxy(&model);
+    QTableView table;
+    table.setModel(&proxy);
+    proxy.sort(model.fieldIndex(ColumnCache::COLUMN_LIBRARYTABLE_ID), Qt::DescendingOrder);
+    CoverArtDelegate delegate(&table);
+    const int column = model.fieldIndex(ColumnCache::COLUMN_LIBRARYTABLE_COVERART);
+    ASSERT_GE(column, 0);
+    QStyleOptionViewItem option;
+    option.rect = QRect(0, 0, 48, 48);
+    const auto render = [&](const QModelIndex& row) {
+        QImage output(48, 48, QImage::Format_RGB32);
+        output.fill(Qt::black);
+        QPainter painter(&output);
+        delegate.paintItem(&painter, option, row);
+        painter.end();
+        return output;
+    };
+    const auto row = proxy.mapFromSource(model.index(0, column));
+    ASSERT_TRUE(row.isValid());
+    EXPECT_EQ(1, row.row()); // Track 1 after reverse sorting.
+    EXPECT_NE(QColor(Qt::red), render(row).pixelColor(24, 24));
+    ASSERT_TRUE(waitForBrowserPreview([&] { return model.artworkPreview(model.index(0, column)) != nullptr; }));
+    const auto* image = model.artworkPreview(model.index(0, column));
+    ASSERT_FALSE(image->isNull());
+    EXPECT_EQ(QSize(128, 64), image->size());
+    EXPECT_EQ(QColor(Qt::red), render(row).pixelColor(24, 24));
+    EXPECT_FALSE(model.getTrackId(model.index(0, column)).isValid());
+    model.showPlaylist(session, {1, 1, 2}, 42);
+    EXPECT_EQ(image, model.artworkPreview(model.index(1, column)));
+    model.clearSession();
+    model.showAllTracks(session);
+    EXPECT_EQ(image, model.artworkPreview(model.index(0, column)));
+    // Absent images are cached too, avoiding a read/repaint loop.
+    model.requestArtworkPreview(model.index(1, column));
+    ASSERT_TRUE(waitForBrowserPreview([&] { return model.artworkPreview(model.index(1, column)) != nullptr; }));
+    EXPECT_TRUE(model.artworkPreview(model.index(1, column))->isNull());
+    session->invalidate();
+    EXPECT_EQ(nullptr, model.artworkPreview(model.index(0, column)));
+    auto reconnected = std::make_shared<RekordboxUsbSession>(volume.path());
+    ASSERT_TRUE(reconnected->load());
+    model.showAllTracks(reconnected);
+    EXPECT_EQ(nullptr, model.artworkPreview(model.index(0, column)));
+}
