+TEST_F(RekordboxRuntimeTrackModelTest, RevokedArtworkWorkerCannotPublishToReconnectedDevice) {
+    QTemporaryDir volume;
+    auto song = track();
+    put32(&song, 28, 7);
+    QByteArray artworkRow(4, '\0');
+    put32(&artworkRow, 0, 7);
+    ASSERT_TRUE(write(pdb(volume), database({{0, song},
+            {13, artworkRow + text("/PIONEER/art.png")}})));
+    QImage image(32, 32, QImage::Format_RGB32);
+    image.fill(Qt::blue);
+    ASSERT_TRUE(image.save(volume.filePath("PIONEER/art.png")));
+    auto session = std::make_shared<RekordboxUsbSession>(volume.path());
+    ASSERT_TRUE(session->load());
+    PausedBrowserPreviewReads paused;
+    RekordboxRuntimeTrackModel model(nullptr, trackCollectionManager());
+    model.showAllTracks(session);
+    model.requestArtworkPreview(model.index(0, 0));
+    QCoreApplication::processEvents();
+    session->invalidate();
+    auto reconnected = std::make_shared<RekordboxUsbSession>(volume.path());
+    ASSERT_TRUE(reconnected->load());
+    ASSERT_TRUE(reconnected->loadTrackAnalysis(1));
+    model.showAllTracks(reconnected);
+    int changes = 0;
+    QObject::connect(&model, &QAbstractItemModel::dataChanged, &model, [&] { ++changes; });
+    paused.resume();
+    QThreadPool::globalInstance()->waitForDone();
+    QCoreApplication::processEvents();
+    EXPECT_EQ(nullptr, model.artworkPreview(model.index(0, 0)));
+    EXPECT_EQ(0, changes);
+    model.requestArtworkPreview(model.index(0, 0));
+    ASSERT_TRUE(waitForBrowserPreview([&] { return model.artworkPreview(model.index(0, 0)) != nullptr; }));
+    EXPECT_EQ(QColor(Qt::blue), model.artworkPreview(model.index(0, 0))->pixelColor(16, 16));
+}
