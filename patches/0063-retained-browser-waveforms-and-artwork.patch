+const QImage* RekordboxRuntimeTrackModel::artworkPreview(const QModelIndex& index) const {
+    const auto* track = trackAt(index);
+    const auto state = sessionState();
+    return track && state && state->isActive()
+            ? m_artworkPreviewCache.object(previewCacheKey(track->rekordboxId, 0)) : nullptr;
+}
+
+void RekordboxRuntimeTrackModel::requestArtworkPreview(const QModelIndex& index) {
+    const auto* track = trackAt(index);
+    const auto state = sessionState();
+    if (!track || !state || !state->isActive() || !m_artworkPreviewCache.maxCost()) return;
+    const auto id = track->rekordboxId;
+    if (m_artworkPreviewCache.contains(previewCacheKey(id, 0)) || m_pendingArtworkPreviews.contains(id)) return;
+    m_pendingArtworkPreviews.insert(id);
+    m_artworkRequests.enqueue(id);
+    schedulePreviewRead();
+}
+
+void RekordboxRuntimeTrackModel::startNextArtworkRead() {
+    const auto id = m_artworkRequests.dequeue();
+    const auto session = m_session;
+    const auto state = sessionState();
+    const auto key = previewCacheKey(id, 0);
+    const auto generation = m_previewGeneration;
+    m_previewReadRunning = true;
+    auto* watcher = new QFutureWatcher<QImage>(this);
+    connect(watcher, &QFutureWatcher<QImage>::finished, this, [this, watcher, id, key, state, generation] {
+        auto artwork = watcher->result();
+        watcher->deleteLater();
+        m_previewReadRunning = false;
+        if (state && state->isActive()) {
+            const int cost = int((artwork.sizeInBytes() + 1023) / 1024) + 1;
+            m_artworkPreviewCache.insert(key, new QImage(std::move(artwork)), cost);
+        }
+        if (generation == m_previewGeneration) m_pendingArtworkPreviews.remove(id);
+        if (state && state->isActive() && state == sessionState()) {
+            const int column = fieldIndex(ColumnCache::COLUMN_LIBRARYTABLE_COVERART);
+            const auto rows = m_rowsByTrackId.value(id);
+            for (const auto row : rows) {
+                if (state != sessionState() || generation != m_previewGeneration) break;
+                if (column >= 0) emit dataChanged(index(row, column), index(row, column));
+            }
+        }
+        schedulePreviewRead();
+    });
+    watcher->setFuture(QtConcurrent::run([session, id] { return session->loadTrackArtwork(id, 128); }));
+}
