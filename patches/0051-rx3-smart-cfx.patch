+TEST_F(Rx3SmartFxTest, PresetMenuSelectsWithoutEnablingAndPersistsSelection) {
+    QWidget parent;
+    parent.resize(600, 400); parent.show();
+    // Initialize Qt's global mouse position before the first popup. The
+    // offscreen platform has no window-system mouse events to do this for us.
+    QTest::mouseMove(parent.windowHandle(), QPoint(10, 10));
+    {
+        WRx3BeatFx panel(config(), effects.get(), &parent);
+        set("preset_open", 1); set("preset_open", 0);
+        auto* menu = parent.findChild<QMenu*>("RX3SmartFxPresets");
+        ASSERT_TRUE(menu);
+        ASSERT_EQ(3, menu->actions().size());
+        QCoreApplication::processEvents();
+        ASSERT_TRUE(menu->isVisible());
+        EXPECT_EQ("FILTER", menu->actions().at(2)->text());
+        EXPECT_TRUE(menu->actions().at(0)->isChecked());
+        QTest::mouseClick(menu, Qt::LeftButton, Qt::NoModifier,
+                menu->actionGeometry(menu->actions().at(1)).center());
+        EXPECT_DOUBLE_EQ(1, ControlObject::get(ConfigKey(WRx3SmartFx::group(), "preset")));
+        EXPECT_DOUBLE_EQ(0, ControlObject::get(ConfigKey(WRx3SmartFx::group(), "enabled")));
+        set("enabled", 1);
+        EXPECT_EQ("org.mixxx.effects.reverb", quick(0)->getEffectSlot(1)->id());
+        EXPECT_EQ("org.mixxx.effects.reverb", quick(1)->getEffectSlot(1)->id());
+        set("preset_open", 1); set("preset_open", 0);
+        QCoreApplication::processEvents();
+        ASSERT_TRUE(menu->isVisible());
+        EXPECT_TRUE(menu->actions().at(1)->isChecked());
+        QTest::mouseClick(menu, Qt::LeftButton, Qt::NoModifier,
+                menu->actionGeometry(menu->actions().at(2)).center());
+        EXPECT_FALSE(quick(0)->getEffectSlot(1)->isLoaded());
+        EXPECT_FALSE(quick(1)->getEffectSlot(1)->isLoaded());
+        EXPECT_FALSE(menu->isVisible());
+        EXPECT_DOUBLE_EQ(1, ControlObject::get(ConfigKey(WRx3SmartFx::group(), "enabled")));
+    }
+    EXPECT_FALSE(parent.findChild<QMenu*>("RX3SmartFxPresets"));
+    WRx3BeatFx restored(config(), effects.get(), &parent);
+    EXPECT_DOUBLE_EQ(2, ControlObject::get(ConfigKey(WRx3SmartFx::group(), "preset")));
+    EXPECT_DOUBLE_EQ(0, ControlObject::get(ConfigKey(WRx3SmartFx::group(), "enabled")));
+}
+
+TEST_F(Rx3SmartFxTest, SelectedEchoActuallyProducesABeatSynchronizedTail) {
+    QWidget parent;
+    WRx3BeatFx panel(config(), effects.get(), &parent);
+    set("knob1", 1);
+    set("enabled", 1);
+    GroupFeatureState features;
+    features.beat_length = GroupFeatureBeatLength{0.5, 1};
+    const auto audio = renderFx<EchoEffect, EchoGroupState>(quick(0)->getEffectSlot(1),
+            48000, 36096, features, [](int frame) { return frame == 1024 ? 0.5 : 0.0; });
+    EXPECT_GT(std::abs(audio[2 * (1024 + 12000)]), 0.1);
+    for (auto value : audio) ASSERT_TRUE(std::isfinite(value));
+}
+
+TEST_F(Rx3SmartFxTest, FilterOnlyRendersLowPassOnMinusAndHighPassOnPlus) {
+    QWidget parent;
+    WRx3BeatFx panel(config(), effects.get(), &parent);
+    set("preset", 2);
+    set("enabled", 1);
+    for (int deck = 0; deck < 2; ++deck) {
+        const auto chain = quick(deck);
+        const auto filter = chain->getEffectSlot(0);
+        EXPECT_EQ("org.mixxx.effects.filter", filter->id());
+        EXPECT_FALSE(chain->getEffectSlot(1)->isLoaded());
+        EXPECT_FALSE(chain->getEffectSlot(2)->isLoaded());
+        const QString knob = QString("knob%1").arg(deck + 1);
+        for (double position : {0.0, 1.0}) {
+            set(knob, position);
+            EXPECT_DOUBLE_EQ(1, ControlObject::get(ConfigKey(chain->group(), "enabled")));
+            EXPECT_NEAR(position == 0 ? 200 : 22050,
+                    rx3FxParameter(filter, "lpf")->getValue(), 1e-6);
+            EXPECT_NEAR(position == 0 ? 13 : 4000,
+                    rx3FxParameter(filter, "hpf")->getValue(), 1e-6);
+            const auto energy = [&](double frequency) {
+                const auto audio = renderFx<FilterEffect, FilterGroupState>(filter,
+                        48000, 24064, {}, [frequency](int frame) {
+                            return 0.25 * std::sin(frame * 2 * 3.141592653589793 * frequency / 48000);
+                        });
+                double sum = 0;
+                for (size_t index = 8192; index < audio.size(); ++index) {
+                    EXPECT_TRUE(std::isfinite(audio[index]));
+                    sum += audio[index] * audio[index];
+                }
+                return sum;
+            };
+            const double low = energy(100);
+            const double high = energy(8000);
+            if (position == 0) {
+                EXPECT_GT(low, 20 * high);
+            } else {
+                EXPECT_GT(high, 20 * low);
+            }
+        }
+        set(knob, 0.5);
+        EXPECT_DOUBLE_EQ(0, ControlObject::get(ConfigKey(chain->group(), "enabled")));
+        EXPECT_DOUBLE_EQ(22050, rx3FxParameter(filter, "lpf")->getValue());
+        EXPECT_DOUBLE_EQ(13, rx3FxParameter(filter, "hpf")->getValue());
+    }
+}

