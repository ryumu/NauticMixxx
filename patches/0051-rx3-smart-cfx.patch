+TEST_F(Rx3SmartFxTest, FilterOnlyRendersLowPassOnMinusAndHighPassOnPlus) {
+    QWidget parent;
+    WRx3BeatFx panel(config(), effects.get(), &parent);
+    set("preset", 2);
+    set("enabled", 1);
+    for (int deck = 0; deck < 2; ++deck) {
+        const auto chain = quick(deck);
+        const auto filter = chain->getEffectSlot(0);
+        EXPECT_EQ("org.mixxx.effects.filter", filter->id());
+        EXPECT_FALSE(chain->getEffectSlot(1)->isLoaded());
+        EXPECT_FALSE(chain->getEffectSlot(2)->isLoaded());
+        const QString knob = QString("knob%1").arg(deck + 1);
+        for (double position : {0.0, 1.0}) {
+            set(knob, position);
+            EXPECT_DOUBLE_EQ(1, ControlObject::get(ConfigKey(chain->group(), "enabled")));
+            EXPECT_NEAR(position == 0 ? 200 : 22050,
+                    rx3FxParameter(filter, "lpf")->getValue(), 1e-6);
+            EXPECT_NEAR(position == 0 ? 13 : 4000,
+                    rx3FxParameter(filter, "hpf")->getValue(), 1e-6);
+            const auto energy = [&](double frequency) {
+                const auto audio = renderFx<FilterEffect, FilterGroupState>(filter,
+                        48000, 24064, {}, [frequency](int frame) {
+                            return 0.25 * std::sin(frame * 2 * 3.141592653589793 * frequency / 48000);
+                        });
+                double sum = 0;
+                for (size_t index = 8192; index < audio.size(); ++index) {
+                    EXPECT_TRUE(std::isfinite(audio[index]));
+                    sum += audio[index] * audio[index];
+                }
+                return sum;
+            };
+            const double low = energy(100);
+            const double high = energy(8000);
+            if (position == 0) {
+                EXPECT_GT(low, 20 * high);
+            } else {
+                EXPECT_GT(high, 20 * low);
+            }
+        }
+        set(knob, 0.5);
+        EXPECT_DOUBLE_EQ(0, ControlObject::get(ConfigKey(chain->group(), "enabled")));
+        EXPECT_DOUBLE_EQ(22050, rx3FxParameter(filter, "lpf")->getValue());
+        EXPECT_DOUBLE_EQ(13, rx3FxParameter(filter, "hpf")->getValue());
+    }
+}

 TEST_F(Rx3BeatFxTest, FourRegistrationsPersistWithoutReplacingOccupiedSlots) {
     QWidget parent;
