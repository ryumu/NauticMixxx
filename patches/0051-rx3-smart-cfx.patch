+TEST_F(Rx3SmartFxTest, KnobsAreIndependentCenteredAndDoNotChangeBeatFxOrTransport) {
+    QWidget parent;
+    WRx3BeatFx panel(config(), effects.get(), &parent);
+    load("org.mixxx.effects.flanger");
+    ControlObject::set(ConfigKey(WRx3BeatFx::unitGroup(), "enabled"), 1);
+    const auto before = quick(0)->getEffectSlot(0)->id();
+    set("knob1", 0.25);
+    EXPECT_EQ(before, quick(0)->getEffectSlot(0)->id());
+    set("enabled", 1);
+    EXPECT_EQ("org.mixxx.effects.filter", quick(0)->getEffectSlot(0)->id());
+    EXPECT_EQ("org.mixxx.effects.echo", quick(0)->getEffectSlot(1)->id());
+    EXPECT_LT(rx3FxParameter(quick(0)->getEffectSlot(0), "lpf")->getValue(), 22050);
+    EXPECT_DOUBLE_EQ(13, rx3FxParameter(quick(0)->getEffectSlot(0), "hpf")->getValue());
+    EXPECT_GT(rx3FxParameter(quick(0)->getEffectSlot(1), "send_amount")->getValue(), 0);
+    EXPECT_DOUBLE_EQ(0, ControlObject::get(ConfigKey(quick(1)->group(), "enabled")));
+    set("knob2", 0.9);
+    EXPECT_GT(rx3FxParameter(quick(1)->getEffectSlot(0), "hpf")->getValue(), 13);
+    EXPECT_DOUBLE_EQ(22050, rx3FxParameter(quick(1)->getEffectSlot(0), "lpf")->getValue());
+    for (double center : {0.5, 8191.0 / 16383, 8192.0 / 16383, 64.0 / 127}) {
+        set("knob1", center);
+        EXPECT_DOUBLE_EQ(0, rx3FxParameter(quick(0)->getEffectSlot(1), "send_amount")->getValue());
+        EXPECT_DOUBLE_EQ(0, ControlObject::get(ConfigKey(quick(0)->group(), "enabled")));
+    }
+    EXPECT_EQ("org.mixxx.effects.flanger", slot->id());
+    EXPECT_DOUBLE_EQ(1, enabled());
+}
