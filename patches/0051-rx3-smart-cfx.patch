+TEST_F(Rx3SmartFxTest, SelectedEchoActuallyProducesABeatSynchronizedTail) {
+    QWidget parent;
+    WRx3BeatFx panel(config(), effects.get(), &parent);
+    set("knob1", 1);
+    set("enabled", 1);
