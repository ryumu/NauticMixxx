+TEST_F(Rx3SmartFxTest, ReactivationUsesCurrentKnobsBeforeQueuedMidiNotifications) {
+    QWidget parent;
+    WRx3BeatFx panel(config(), effects.get(), &parent);
+    set("preset", 2);
+    set("knob1", 0.1);
+    set("knob2", 0.9);
+    set("enabled", 1);
+    for (double position : {0.85, 0.15, 0.5}) {
+        set("enabled", 0);
+        const double previousSuper1 = quick(0)->getSuperParameter();
+        const double previousSuper2 = quick(1)->getSuperParameter();
+        // Controller events arrive on another thread. Their control values
+        // are current even if the GUI has not handled the notifications yet.
+        std::thread controller([&] {
+            set("knob1", 1 - position);
+            set("knob2", position);
+            set("knob1", position);
+            set("knob2", 1 - position);
+        });
+        controller.join();
+        EXPECT_DOUBLE_EQ(previousSuper1, quick(0)->getSuperParameter());
+        EXPECT_DOUBLE_EQ(previousSuper2, quick(1)->getSuperParameter());
+        set("enabled", 1);
+        const auto expectCurrentPositions = [&] {
+            for (int deck = 0; deck < 2; ++deck) {
+                const double current = deck == 0 ? position : 1 - position;
+                const double amount = qBound(0.0, (std::abs(current - 0.5) - 0.005) / 0.495, 1.0);
+                const auto filter = quick(deck)->getEffectSlot(0);
+                EXPECT_DOUBLE_EQ(current < 0.5 ? 22050 * std::pow(200.0 / 22050, amount) : 22050,
+                        rx3FxParameter(filter, "lpf")->getValue());
+                EXPECT_DOUBLE_EQ(current > 0.5 ? 13 * std::pow(4000.0 / 13, amount) : 13,
+                        rx3FxParameter(filter, "hpf")->getValue());
+                EXPECT_DOUBLE_EQ(amount > 0 ? 1 : 0,
+                        ControlObject::get(ConfigKey(quick(deck)->group(), "enabled")));
+            }
+        };
+        expectCurrentPositions();
+        QCoreApplication::processEvents();
+        expectCurrentPositions();
+    }
+}
