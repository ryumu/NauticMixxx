+// Nautic combinations of built-in DSP, following the FLX4 Smart CFX controls.
+// These are not reproductions of rekordbox's proprietary preset algorithms.
+class WRx3SmartFx : public QObject {
+  public:
+    WRx3SmartFx(UserSettingsPointer config, EffectsManager* effects, QWidget* parent)
+            : QObject(parent), m_config(config), m_effects(effects), m_parent(parent) {
+        m_preset = qBound(0, config->getValue(ConfigKey(group(), "preset"), 0), 2);
+        addControl("enabled", 0, [this](double value) { setEnabled(value > 0); });
+        addControl("toggle", 0, [this](double value) {
+            if (value > 0) ControlObject::set(ConfigKey(group(), "enabled"), m_active ? 0 : 1);
+        });
+        addControl("preset", m_preset, [this](double value) {
+            if (!std::isfinite(value) || value < 0 || value > 2) return;
+            const int preset = qRound(value);
+            if (m_preset == preset) return;
+            m_preset = preset;
+            m_config->setValue(ConfigKey(group(), "preset"), preset);
+            if (m_active) loadPreset();
+            refreshMenuSelection();
+        });
+        addControl("knob1", 0.5, [this](double) { if (m_active) applyKnob(0); });
+        addControl("knob2", 0.5, [this](double) { if (m_active) applyKnob(1); });
+        addControl("preset_open", 0, [this](double value) { if (value > 0) showPresets(); });
+        addControl("available", effects ? 1 : 0, [](double) {});
+    }
+    ~WRx3SmartFx() override {
+        setEnabled(false);
+        delete m_menu.data();
+    }
+    static QString group() { return QStringLiteral("[RX3SmartFx]"); }
+    static QString quickGroup(int deck) {
+        return QString("[QuickEffectRack1_[Channel%1]]").arg(deck + 1);
+    }
+
+  private:
+    struct SavedChain {
+        EffectChainPointer chain;
+        EffectChainPresetPointer preset;
+        double mix = 1;
+        double enabled = 1;
+        std::array<double, 3> slotEnabled{};
+    };
+    void addControl(const QString& key, double initial, std::function<void(double)> callback) {
+        const ConfigKey configKey(group(), key);
+        // Skin bindings may create the controls before the native FX panel.
+        // Reuse those objects so the badge and controller share the same state.
+        if (!ControlObject::exists(configKey))
+            m_controls.push_back(std::make_unique<ControlObject>(configKey));
+        ControlObject::set(configKey, initial);
+        auto* proxy = new ControlProxy(configKey, this);
+        proxy->connectValueChanged(this, std::move(callback));
+    }
+    void setEnabled(bool enabled) {
+        if (enabled == m_active) return;
+        if (enabled) {
+            // Validate everything before changing either channel.
+            if (!m_effects || !manifest("filter") ||
+                    (m_preset != 2 && !manifest(m_preset == 0 ? "echo" : "reverb"))) {
+                ControlObject::set(ConfigKey(group(), "enabled"), 0);
+                return;
+            }
+            for (int deck = 0; deck < 2; ++deck) {
+                m_saved[deck].chain = m_effects->getEffectChain(quickGroup(deck));
+                if (!m_saved[deck].chain) {
+                    ControlObject::set(ConfigKey(group(), "enabled"), 0);
+                    return;
+                }
+            }
+            for (auto& saved : m_saved) {
+                saved.preset = EffectChainPresetPointer::create(saved.chain.data());
+                saved.mix = ControlObject::get(ConfigKey(saved.chain->group(), "mix"));
+                saved.enabled = ControlObject::get(ConfigKey(saved.chain->group(), "enabled"));
+                for (int index = 0; index < 3; ++index)
+                    saved.slotEnabled[index] = ControlObject::get(
+                            ConfigKey(saved.chain->getEffectSlot(index)->getGroup(), "enabled"));
+            }
+            m_active = true;
+            loadPreset();
+        } else {
+            m_active = false;
+            for (auto& saved : m_saved) {
+                if (!saved.preset) continue;
+                ControlObject::set(ConfigKey(saved.chain->group(), "enabled"), 0);
+                saved.chain->loadChainPreset(saved.preset);
+                for (int index = 0; index < 3; ++index) {
+                    const auto slot = saved.chain->getEffectSlot(index);
+                    const auto preset = saved.preset->effectPresets().at(index);
+                    // QuickEffectChain forces super1 on load. Restore values
+                    // edited independently of the linked metaknobs as well.
+                    slot->setMetaParameter(preset->metaParameter(), true);
+                    for (const auto& parameter : preset->getParameterPresets())
+                        rx3SetFxParameter(slot, parameter.id(), parameter.value());
+                    ControlObject::set(ConfigKey(slot->getGroup(), "enabled"), saved.slotEnabled[index]);
+                }
+                ControlObject::set(ConfigKey(saved.chain->group(), "mix"), saved.mix);
+                ControlObject::set(ConfigKey(saved.chain->group(), "enabled"), saved.enabled);
+                saved.preset.clear();
+            }
+        }
+    }
+    EffectManifestPointer manifest(const QString& name) const {
+        return m_effects->getBackendManager()->getManifestFromUniqueId("org.mixxx.effects." + name);
+    }
+    void loadPreset() {
+        // Construct from manifests, independent of installed preset list order
+        // and user-modified effect defaults.
+        QDomDocument doc;
+        auto preset = EffectChainPresetPointer::create(manifest("filter"));
+        preset->setName(m_preset == 2 ? "SMART CFX: FILTER" :
+                (m_preset == 0 ? "SMART CFX: ECHO + FILTER" : "SMART CFX: REVERB + FILTER"));
+        auto root = preset->toXml(&doc);
+        if (m_preset != 2)
+            root.firstChildElement("Effects").appendChild(
+                    EffectPreset(manifest(m_preset == 0 ? "echo" : "reverb")).toXml(&doc));
+        preset = EffectChainPresetPointer::create(root);
+        for (int deck = 0; deck < 2; ++deck) {
+            auto chain = m_saved[deck].chain;
+            ControlObject::set(ConfigKey(chain->group(), "enabled"), 0);
+            chain->loadChainPreset(preset);
+            ControlObject::set(ConfigKey(chain->group(), "mix"), 1);
+            rx3SetBeatFxEnabled(chain->getEffectSlot(0), true);
+            rx3SetBeatFxEnabled(chain->getEffectSlot(1), m_preset != 2);
+            rx3SetBeatFxEnabled(chain->getEffectSlot(2), false);
+            const auto space = chain->getEffectSlot(1);
+            rx3SetFxParameter(space, "delay_time", 0.5);
+            rx3SetFxParameter(space, "quantize", 1);
+            rx3SetFxParameter(space, "triplet", 0);
+            rx3SetFxParameter(space, "pingpong_amount", 0);
+            rx3SetFxParameter(space, "bandwidth", 1);
+            applyKnob(deck);
+        }
+    }
+    void applyKnob(int deck) {
+        auto chain = m_saved[deck].chain;
+        // Read the latest received position, including on activation/preset
+        // load. Queued controller notifications may still carry older values.
+        const double value = ControlObject::get(ConfigKey(group(),
+                QString("knob%1").arg(deck + 1)));
+        if (!std::isfinite(value)) return;
+        const double position = qBound(0.0, value, 1.0);
+        // The center detent can report either adjacent MIDI step.
+        const double amount = qBound(0.0, (std::abs(position - 0.5) - 0.005) / 0.495, 1.0);
+        const auto filter = chain->getEffectSlot(0);
+        const auto space = chain->getEffectSlot(1);
+        rx3SetFxParameter(filter, "lpf", position < 0.5 ? 22050 * std::pow(200.0 / 22050, amount) : 22050);
+        rx3SetFxParameter(filter, "hpf", position > 0.5 ? 13 * std::pow(4000.0 / 13, amount) : 13);
+        if (m_preset != 2) {
+            rx3SetFxParameter(space, "send_amount", 0.65 * amount);
+            rx3SetFxParameter(space, "feedback_amount", 0.25 + 0.45 * amount);
+            rx3SetFxParameter(space, "decay", 0.3 + 0.5 * amount);
+        }
+        ControlObject::set(ConfigKey(chain->group(), "enabled"), amount > 0 ? 1 : 0);
+    }
+    void refreshMenuSelection() {
+        if (!m_menu) return;
+        for (auto* action : m_menu->actions())
+            action->setChecked(action->data().toInt() == m_preset);
+    }
+    void showPresets() {
+        if (m_menu && m_menu->isVisible()) {
+            m_menu->hide();
+            return;
+        }
+        auto* window = m_parent->window();
+        auto* anchor = window->findChild<QWidget*>("RX3SmartFxPreset");
+        if (anchor && !anchor->isVisible()) anchor = nullptr;
+        if (!m_menu) {
+            m_menu = new QMenu(window);
+            m_menu->setObjectName("RX3SmartFxPresets");
+            m_menu->setStyleSheet(
+                    "QMenu { background: #181818; color: #ddd; border: 1px solid #555; }"
+                    "QMenu::item { padding: 10px 18px; }"
+                    "QMenu::item:selected { background: #007ce0; color: #fff; }");
+            auto* choices = new QActionGroup(m_menu);
+            choices->setExclusive(true);
+            const QStringList names{"ECHO + FILTER", "REVERB + FILTER", "FILTER"};
+            for (int index = 0; index < names.size(); ++index) {
+                auto* action = m_menu->addAction(names[index]);
+                action->setCheckable(true);
+                action->setData(index);
+                choices->addAction(action);
+                connect(action, &QAction::triggered, this, [index] {
+                    ControlObject::set(ConfigKey(group(), "preset"), index);
+                });
+            }
+        }
+        auto font = (anchor ? anchor : window)->font();
+        font.setPixelSize(qMax(16, font.pixelSize()));
+        m_menu->setFont(font);
+        m_menu->setMinimumWidth(anchor ? anchor->width() : 180);
+        refreshMenuSelection();
+        // Hardware SHIFT + SMART CFX uses the same menu. When its on-screen
+        // anchor is hidden (BROWSE), place it at the top of the application.
+        const QPoint position = anchor ? anchor->mapToGlobal(QPoint(0, anchor->height())) :
+                window->mapToGlobal(QPoint(window->width() / 2, 0));
+        m_menu->popup(position);
+    }
+    UserSettingsPointer m_config;
+    EffectsManager* m_effects;
+    QWidget* m_parent;
+    bool m_active = false;
+    int m_preset = 0;
+    std::array<SavedChain, 2> m_saved;
+    std::vector<std::unique_ptr<ControlObject>> m_controls;
+    QPointer<QMenu> m_menu;
+};
