+TEST_F(Rx3SmartFxTest, DisableAndDestructionRestoreCompleteQuickEffectState) {
+    QWidget parent;
+    const auto chain = quick(0);
+    chain->loadChainPreset(EffectChainPresetPointer::create(
+            effects->getBackendManager()->getManifestFromUniqueId("org.mixxx.effects.echo")));
+    chain->setSuperParameter(0.3, true);
+    rx3SetFxParameter(chain->getEffectSlot(0), "feedback_amount", 0.43);
+    rx3SetFxParameter(chain->getEffectSlot(0), "send_amount", 0.17);
+    ControlObject::set(ConfigKey(chain->group(), "enabled"), 0);
+    ControlObject::set(ConfigKey(chain->group(), "mix"), 0.37);
+    rx3SetBeatFxEnabled(chain->getEffectSlot(0), false);
+    auto* panel = new WRx3BeatFx(config(), effects.get(), &parent);
+    for (bool destroy : {false, true}) {
+        set("enabled", 1);
+        set("knob1", 1);
+        set("preset", 1);
+        EXPECT_EQ("org.mixxx.effects.reverb", chain->getEffectSlot(1)->id());
+        if (destroy) delete panel;
+        else set("enabled", 0);
+        EXPECT_EQ("org.mixxx.effects.echo", chain->getEffectSlot(0)->id());
+        EXPECT_FALSE(chain->getEffectSlot(1)->isLoaded());
+        EXPECT_DOUBLE_EQ(0.43, rx3FxParameter(chain->getEffectSlot(0), "feedback_amount")->getValue());
+        EXPECT_DOUBLE_EQ(0.17, rx3FxParameter(chain->getEffectSlot(0), "send_amount")->getValue());
+        EXPECT_DOUBLE_EQ(0.3, chain->getSuperParameter());
+        EXPECT_DOUBLE_EQ(0, ControlObject::get(ConfigKey(chain->group(), "enabled")));
+        EXPECT_DOUBLE_EQ(0, ControlObject::get(ConfigKey(chain->getEffectSlot(0)->getGroup(), "enabled")));
+        EXPECT_DOUBLE_EQ(0.37, ControlObject::get(ConfigKey(chain->group(), "mix")));
+    }
+}
