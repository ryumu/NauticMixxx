+TEST_F(Rx3SmartFxTest, SkinBadgeTogglesWithOneTapAndSelectsPresetsInPlace) {
+    const QString skinDir = qEnvironmentVariable("NAUTIC_SKIN_DIR");
+    if (skinDir.isEmpty()) GTEST_SKIP() << "Set NAUTIC_SKIN_DIR for actual skin bindings";
+    QFile topbar(QDir(skinDir).filePath("topbar.xml"));
+    ASSERT_TRUE(topbar.open(QIODevice::ReadOnly));
+    QDomDocument source;
+    ASSERT_TRUE(source.setContent(topbar.readAll()));
+    QDomElement badge;
+    const auto groups = source.elementsByTagName("WidgetGroup");
+    for (int index = 0; index < groups.size(); ++index) {
+        const auto group = groups.at(index).toElement();
+        if (group.firstChildElement("ObjectName").text() == "RX3SmartFxBadge") badge = group;
+    }
+    ASSERT_FALSE(badge.isNull());
+    QTemporaryDir directory;
+    QDomDocument skin;
+    auto root = skin.createElement("skin"); skin.appendChild(root);
+    auto layout = skin.createElement("Layout");
+    layout.appendChild(skin.createTextNode("horizontal")); root.appendChild(layout);
+    auto children = skin.createElement("Children"); root.appendChild(children);
+    children.appendChild(skin.importNode(badge, true));
+    QFile definition(directory.filePath("skin.xml"));
+    ASSERT_TRUE(definition.open(QIODevice::WriteOnly));
+    definition.write(skin.toByteArray()); definition.close();
+    QWidget parent;
+    QSet<ControlObject*> skinControls;
+    ConfigObject<ConfigValueKbd> keyboardConfig(directory.filePath("keyboard.cfg"));
+    KeyboardEventFilter keyboard(&keyboardConfig);
+    ControllerManager controllers(config(), ControllerManager::DeviceDiscovery::Disabled);
+    LegacySkinParser parser(config(), &skinControls, &keyboard, nullptr, &controllers,
+            nullptr, nullptr, effects.get(), nullptr);
+    auto* canvas = parser.parseSkin(directory.path(), &parent);
+    ASSERT_TRUE(canvas);
+    {
+        auto* original = ControlObject::getControl(ConfigKey(WRx3SmartFx::group(), "preset"));
+        WRx3SmartFx smart(config(), effects.get(), canvas);
+        EXPECT_EQ(original, ControlObject::getControl(ConfigKey(WRx3SmartFx::group(), "preset")));
+        canvas->show(); parent.show(); QCoreApplication::processEvents();
+        auto* status = canvas->findChild<WPushButton*>("RX3SmartFxStatus");
+        auto* preset = canvas->findChild<WPushButton*>("RX3SmartFxPreset");
+        ASSERT_TRUE(status); ASSERT_TRUE(preset);
+        EXPECT_EQ(0, status->readDisplayValue());
+        for (int i = 0; i < 3; ++i) {
+            QTest::mouseClick(status, Qt::LeftButton);
+            QTRY_COMPARE(status->readDisplayValue(), 1);
+            EXPECT_DOUBLE_EQ(1, ControlObject::get(ConfigKey(WRx3SmartFx::group(), "enabled")));
+            EXPECT_FALSE(parent.findChild<QMenu*>("RX3SmartFxPresets"));
+            QTest::mouseClick(status, Qt::LeftButton);
+            QTRY_COMPARE(status->readDisplayValue(), 0);
+            EXPECT_DOUBLE_EQ(0, ControlObject::get(ConfigKey(WRx3SmartFx::group(), "toggle")));
+        }
+        set("enabled", 1);
+        QTRY_COMPARE(status->readDisplayValue(), 1);
+        for (const int choice : {1, 2, 0}) {
+            QTest::mouseClick(preset, Qt::LeftButton);
+            QCoreApplication::processEvents();
+            auto* menu = parent.findChild<QMenu*>("RX3SmartFxPresets");
+            ASSERT_TRUE(menu);
+            EXPECT_TRUE(menu->isVisible());
+            EXPECT_FALSE(parent.findChild<QDialog*>("RX3SmartFxPresets"));
+            EXPECT_DOUBLE_EQ(0, ControlObject::get(ConfigKey(WRx3SmartFx::group(), "preset_open")));
+            auto* action = menu->actions().at(choice);
+            QTest::mouseClick(menu, Qt::LeftButton, Qt::NoModifier, menu->actionGeometry(action).center());
+            QCoreApplication::processEvents();
+            EXPECT_FALSE(menu->isVisible());
+            QTRY_COMPARE(preset->readDisplayValue(), choice);
+            EXPECT_TRUE(action->isChecked());
+            EXPECT_EQ(1, status->readDisplayValue());
+        }
+        QTest::mouseClick(preset, Qt::LeftButton);
+        auto* menu = parent.findChild<QMenu*>("RX3SmartFxPresets");
+        ASSERT_TRUE(menu);
+        menu->close();
+        EXPECT_DOUBLE_EQ(0, ControlObject::get(ConfigKey(WRx3SmartFx::group(), "preset")));
+        EXPECT_DOUBLE_EQ(1, ControlObject::get(ConfigKey(WRx3SmartFx::group(), "enabled")));
+        set("enabled", 0);
+        QTRY_COMPARE(status->readDisplayValue(), 0);
+    }
+    delete canvas;
+    qDeleteAll(skinControls);
+}
