diff --git a/src/test/rx3overviewcache_test.cpp b/src/test/rx3overviewcache_test.cpp
new file mode 100644
--- /dev/null
+++ b/src/test/rx3overviewcache_test.cpp
@@ -0,0 +1,115 @@
+#include <gtest/gtest.h>
+#include <QLinearGradient>
+
+#include "widget/rx3overviewcache.h"
+
+namespace {
+using namespace mixxx::rekordbox;
+}
+
+TEST(Rx3OverviewCache, RepaintsReusePixelsAndEveryVisualInputInvalidates) {
+    rx3::OverviewWaveformCache cache;
+    std::shared_ptr<const WaveformSet> source = std::make_shared<WaveformSet>();
+    auto mode = WaveformMode::Blue;
+    QSize size(300, 80);
+    qreal scale = 1, dpr = 1;
+    std::array<float, 3> gains{1, 1, 1};
+    int renders = 0;
+    const auto draw = [&] {
+        return cache.image(source, mode, size, scale, dpr, gains, [&](QPainter* painter) {
+            ++renders;
+            painter->fillRect(0, 0, 10, 10, Qt::red);
+        }).cacheKey();
+    };
+    auto key = draw();
+    EXPECT_NE(0, key);
+    for (int repaint = 0; repaint < 100; ++repaint) EXPECT_EQ(key, draw());
+    EXPECT_EQ(1, renders);
+    const auto changed = [&] {
+        const auto next = draw();
+        EXPECT_NE(key, next);
+        key = next;
+        EXPECT_EQ(key, draw());
+    };
+    mode = WaveformMode::RGB; changed();
+    size.setWidth(450); changed();
+    scale = 1.5; changed();
+    dpr = 1.25; changed();
+    gains[1] = 0.5f; changed();
+    source = std::make_shared<WaveformSet>(); changed();
+    EXPECT_EQ(7, renders);
+    cache.clear(); changed();
+    EXPECT_EQ(8, renders);
+}
+
+TEST(Rx3OverviewCache, DoesNotRetainUnloadedTracksAndBoundsImageMemory) {
+    rx3::OverviewWaveformCache cache;
+    auto source = std::make_shared<WaveformSet>();
+    const std::weak_ptr<const WaveformSet> lifetime = source;
+    const std::array<float, 3> gains{1, 1, 1};
+    int renders = 0;
+    const auto draw = [&](QSize size) -> const QImage& {
+        return cache.image(source, WaveformMode::Blue, size, 1, 1, gains,
+                [&](QPainter*) { ++renders; });
+    };
+    EXPECT_FALSE(draw(QSize(300, 80)).isNull());
+    EXPECT_TRUE(draw(QSize(8192, 8192)).isNull());
+    EXPECT_TRUE(draw(QSize()).isNull());
+    EXPECT_EQ(1, renders);
+    EXPECT_FALSE(draw(QSize(300, 80)).isNull());
+    source.reset();
+    EXPECT_TRUE(lifetime.expired());
+    EXPECT_TRUE(draw(QSize(300, 80)).isNull());
+}
+
+TEST(Rx3OverviewCache, CachedPreviewMatchesDirectPixelsAtFractionalDisplayScales) {
+    auto source = std::make_shared<WaveformSet>();
+    auto& preview = source->overview[1];
+    preview.tag = "PWV4";
+    for (int i = 0; i < 1024; ++i) {
+        preview.columns.append(WaveformColumn{quint8(i % 32), quint8(i % 23),
+                quint8(i % 17), quint8(i % 32), quint8(i % 256)});
+    }
+    for (const auto mode : {WaveformMode::Blue, WaveformMode::RGB, WaveformMode::ThreeBand}) {
+        for (const qreal dpr : {1., 1.25, 1.5, 2.}) {
+            SCOPED_TRACE(int(mode));
+            SCOPED_TRACE(dpr);
+            rx3::OverviewWaveformCache cache;
+            const QSize pixels(qRound(300 * dpr), qRound(80 * dpr));
+            const std::array<float, 3> gains{1, 0.7f, 0.5f};
+            int renders = 0;
+            const auto render = [&](QPainter* painter) {
+                ++renders;
+                painter->setRenderHint(QPainter::Antialiasing, false);
+                if (mode == WaveformMode::ThreeBand) {
+                    renderColumns(preview, mode, 0, 1024. / 150, pixels.width(),
+                            28 * dpr, true, gains,
+                            [&](float x1, float y1, float x2, float y2, QRgb color) {
+                                painter->fillRect(QRectF(x1, std::floor(y1), x2 - x1,
+                                        std::ceil(y2) - std::floor(y1)), QColor(color));
+                            });
+                } else {
+                    renderPreviewColumns(preview, mode, pixels.width(), 60 * dpr, gains,
+                            [&](float x1, float y1, float x2, float y2, QRgb c1, QRgb c2) {
+                                QLinearGradient gradient(0, y1, 0, y2);
+                                gradient.setColorAt(0, QColor(c1));
+                                gradient.setColorAt(1, QColor(c2));
+                                painter->fillRect(QRectF(x1, y1, x2 - x1, y2 - y1), gradient);
+                            }, 28 * dpr);
+                }
+            };
+            QImage direct(pixels, QImage::Format_ARGB32_Premultiplied);
+            direct.fill(QColor("#202020"));
+            { QPainter painter(&direct); render(&painter); }
+            for (int repaint = 0; repaint < 3; ++repaint) {
+                const auto& image = cache.image(source, mode, pixels, 1, dpr, gains, render);
+                ASSERT_FALSE(image.isNull());
+                QImage retained(pixels, QImage::Format_ARGB32_Premultiplied);
+                retained.fill(QColor("#202020"));
+                { QPainter painter(&retained); painter.drawImage(QPoint(0, 0), image); }
+                EXPECT_EQ(direct, retained);
+            }
+            EXPECT_EQ(2, renders); // one reference render and one cached render
+        }
+    }
+}
