diff --git a/cmake/NauticPi.cmake b/cmake/NauticPi.cmake
new file mode 100644
--- /dev/null
+++ b/cmake/NauticPi.cmake
@@ -0,0 +1,53 @@
+# Opt-in native Pi profiles. The ordinary desktop builds keep their flags.
+set(NAUTIC_PI_PROFILE "off" CACHE STRING "Pi CPU profile: off, pi4 (also Pi 5), pi5")
+set_property(CACHE NAUTIC_PI_PROFILE PROPERTY STRINGS off pi4 pi5)
+option(NAUTIC_PI_LTO "Enable LTO for the selected Pi profile" OFF)
+set(NAUTIC_PI_CPU "" CACHE INTERNAL "Selected Pi CPU" FORCE)
+if(NOT NAUTIC_PI_PROFILE MATCHES "^(off|pi4|pi5)$")
+  message(FATAL_ERROR "NAUTIC_PI_PROFILE must be off, pi4 or pi5")
+endif()
+if(NAUTIC_PI_PROFILE STREQUAL "off")
+  if(NAUTIC_PI_LTO)
+    message(FATAL_ERROR "NAUTIC_PI_LTO requires a Pi profile")
+  endif()
+  return()
+endif()
+if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux" OR
+    NOT CMAKE_SYSTEM_PROCESSOR MATCHES "^(aarch64|arm64|ARM64)$" OR
+    NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
+  message(FATAL_ERROR "Pi profiles require 64-bit ARM Linux")
+endif()
+if(NOT CMAKE_C_COMPILER_ID MATCHES "^(GNU|Clang)$" OR
+    NOT CMAKE_CXX_COMPILER_ID MATCHES "^(GNU|Clang)$")
+  message(FATAL_ERROR "Pi profiles require GCC or Clang")
+endif()
+if(NOT OPTIMIZE STREQUAL "portable")
+  message(FATAL_ERROR "Pi profiles require OPTIMIZE=portable to avoid conflicting CPU flags")
+endif()
+if(NAUTIC_PI_PROFILE STREQUAL "pi4")
+  set(NAUTIC_PI_CPU cortex-a72 CACHE INTERNAL "Selected Pi CPU" FORCE)
+  set(nautic_pi_number 4)
+else()
+  set(NAUTIC_PI_CPU cortex-a76 CACHE INTERNAL "Selected Pi CPU" FORCE)
+  set(nautic_pi_number 5)
+endif()
+include(CheckCCompilerFlag)
+include(CheckCXXCompilerFlag)
+set(nautic_pi_c_check "NAUTIC_${NAUTIC_PI_PROFILE}_C_SUPPORTED")
+set(nautic_pi_cxx_check "NAUTIC_${NAUTIC_PI_PROFILE}_CXX_SUPPORTED")
+check_c_compiler_flag("-mcpu=${NAUTIC_PI_CPU}" ${nautic_pi_c_check})
+check_cxx_compiler_flag("-mcpu=${NAUTIC_PI_CPU}" ${nautic_pi_cxx_check})
+if(NOT ${nautic_pi_c_check} OR NOT ${nautic_pi_cxx_check})
+  message(FATAL_ERROR "Compiler does not support -mcpu=${NAUTIC_PI_CPU}")
+endif()
+add_compile_options("-mcpu=${NAUTIC_PI_CPU}")
+add_compile_definitions("NAUTIC_PI_PROFILE=${nautic_pi_number}")
+if(NAUTIC_PI_LTO)
+  include(CheckIPOSupported)
+  check_ipo_supported(RESULT nautic_pi_ipo_supported OUTPUT nautic_pi_ipo_error LANGUAGES C CXX)
+  if(NOT nautic_pi_ipo_supported)
+    message(FATAL_ERROR "Pi LTO is unavailable: ${nautic_pi_ipo_error}")
+  endif()
+endif()
+set(CMAKE_INTERPROCEDURAL_OPTIMIZATION ${NAUTIC_PI_LTO})
+message(STATUS "NauticMixxx ${NAUTIC_PI_PROFILE}: ${NAUTIC_PI_CPU}, retained overview, LTO=${NAUTIC_PI_LTO}")
diff --git a/src/widget/rx3overviewcache.h b/src/widget/rx3overviewcache.h
new file mode 100644
--- /dev/null
+++ b/src/widget/rx3overviewcache.h
@@ -0,0 +1,69 @@
+#pragma once
+
+#include <QImage>
+#include <QPainter>
+#include <array>
+#include <memory>
+
+#include "waveform/rekordboxwaveform.h"
+
+namespace rx3 {
+
+// GUI-thread-only, one image per overview. The imported overview is immutable;
+// signed PCM, play position, cues and warning overlays are not part of this image.
+class OverviewWaveformCache {
+  public:
+    void clear() {
+        m_source.reset();
+        m_image = QImage();
+    }
+
+    template<typename Render>
+    const QImage& image(const std::shared_ptr<const mixxx::rekordbox::WaveformSet>& source,
+            mixxx::rekordbox::WaveformMode mode,
+            QSize pixels,
+            qreal referenceScale,
+            qreal devicePixelRatio,
+            const std::array<float, 3>& gains,
+            Render render) {
+        // Avoid an unbounded allocation on large displays; use direct painting.
+        constexpr qint64 kMaxPixels = 4 * 1024 * 1024; // 16 MiB ARGB
+        if (!source || pixels.isEmpty() || qint64(pixels.width()) * pixels.height() > kMaxPixels) {
+            clear();
+            return m_image;
+        }
+        if (!m_image.isNull() && m_source.lock() == source && m_mode == mode &&
+                m_image.size() == pixels && m_referenceScale == referenceScale &&
+                m_devicePixelRatio == devicePixelRatio && m_gains == gains) {
+            return m_image;
+        }
+        QImage next(pixels, QImage::Format_ARGB32_Premultiplied);
+        if (next.isNull()) {
+            clear();
+            return m_image;
+        }
+        next.fill(Qt::transparent);
+        {
+            QPainter painter(&next);
+            painter.setRenderHint(QPainter::Antialiasing, false);
+            render(&painter);
+        }
+        m_image = std::move(next);
+        m_source = source; // weak ownership does not retain an unloaded track
+        m_mode = mode;
+        m_referenceScale = referenceScale;
+        m_devicePixelRatio = devicePixelRatio;
+        m_gains = gains;
+        return m_image;
+    }
+
+  private:
+    QImage m_image;
+    std::weak_ptr<const mixxx::rekordbox::WaveformSet> m_source;
+    mixxx::rekordbox::WaveformMode m_mode = mixxx::rekordbox::WaveformMode::Blue;
+    qreal m_referenceScale = 0;
+    qreal m_devicePixelRatio = 0;
+    std::array<float, 3> m_gains{};
+};
+
+} // namespace rx3
